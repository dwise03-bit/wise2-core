# WISE² Customer Journey Environment Configuration
STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXX
STRIPE_STARTER_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXX
STRIPE_PRO_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXX

SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_FROM_EMAIL=billing@wise2.io

DATABASE_URL=postgresql://wise2:wise2@localhost:5432/wise2_prod
APP_URL=https://wise2.io
API_BASE_URL=https://api.wise2.io

TRIAL_DAYS=14
ENABLE_TRIALS=true
NODE_ENV=production
PORT=3000

# ============================================================================
# WISE² REVENUE OS
# ----------------------------------------------------------------------------
# Feature gate. With REVENUE_OS_ENABLED unset or "false", no Revenue OS route
# is reachable and no Revenue OS automation runs — existing WISE² behaviour is
# unchanged. Per-tenant rollout is controlled separately by
# Tenant.revenueOsEnabled in the database; both must be true.
# ============================================================================
REVENUE_OS_ENABLED=false
WISE_HVAC_TENANT_SLUG=wise-hvac

# Provider credentials. Leave blank to run against the mock provider; a
# provider with missing credentials reports NEEDS_CONFIG rather than failing.
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Revenue OS background worker. Requires REVENUE_OS_ENABLED=true as well.
# Leave false on the API container and run a second container with this set
# to true to split workers out; both flags off means no worker runs at all.
REVENUE_OS_WORKER=false
REVENUE_OS_WORKER_CONCURRENCY=5

# WISE DEFENSE — SAFETY RADAR + COMMS GRID
# Disabled unless explicitly enabled. No demo data is loaded unless its separate
# flag is true, and never set that flag in a production environment.
WISE_DEFENSE_ENABLED=false
WISE_DEFENSE_DEMO_MODE=false
# Server-only URL used by the dashboard to read the enrolled edge gateway.
# Prefer a private Tailscale address; never prefix this variable with NEXT_PUBLIC_.
WISE_DEFENSE_EDGE_URL=
INCIDENT_PROVIDER_ENABLED=false
MESHTASTIC_ENABLED=false
MESHTASTIC_CONNECTION_TYPE=
MESHTASTIC_SERIAL_PORT=
MESHTASTIC_TCP_HOST=
MESHTASTIC_TCP_PORT=
SDR_ENABLED=false
SDR_DEVICE_TYPE=
WISE_DEFENSE_NOTIFICATIONS_ENABLED=false
WISE_DEFENSE_AI_ENABLED=false

# ============================================================================
# JOBBER INTEGRATION
# ============================================================================
# Sync field service data from Jobber into WISE² Revenue Engine
# Get credentials from: Jobber → Settings → API

JOBBER_ENABLED=false
JOBBER_ACCOUNT_ID=
JOBBER_ACCESS_TOKEN=
JOBBER_SYNC_INTERVAL=15

# ============================================================================
# HERMES LOCAL AI CONFIGURATION
# ============================================================================
# Ollama endpoint and model selection
OLLAMA_BASE_URL=http://127.0.0.1:11434
HERMES_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_CHAT_MODEL=wise2:latest

# Hermes request timeout (milliseconds)
HERMES_TIMEOUT_MS=90000

# FAST mode: optimized for quick interactive responses
# Disable thinking, smaller context window
HERMES_FAST_THINK=false
HERMES_FAST_NUM_CTX=4096
HERMES_FAST_NUM_PREDICT=1024

# DEEP mode: for complex reasoning and larger context
# Enable thinking, larger context window
HERMES_DEEP_THINK=true
HERMES_DEEP_NUM_CTX=16384
HERMES_DEEP_NUM_PREDICT=2048

# CJAYS Google Workspace OAuth (Calendar, Drive, Gmail)
# Callback must exactly match the URI registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CJAYS_GOOGLE_REDIRECT_URI=https://wise2.net/api/v1/cjays/google/callback
# Private GPU media services (recommended: Tailscale address, never public ports)
COMFYUI_API_URL=http://100.68.145.5:8188
MUSICGEN_API_URL=http://100.68.145.5:4900
