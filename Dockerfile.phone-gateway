# WISE² Phone Gateway Dockerfile
# Real-time AI phone orchestration service
# Connects Asterisk + STT + LLM + TTS

FROM node:18-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source
COPY apps/phone-gateway ./apps/phone-gateway
COPY tsconfig*.json ./

# Build
RUN npm run build --workspace=@wise2/phone-gateway

# Runtime
FROM node:18-alpine

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache \
    curl \
    tini

# Copy from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/phone-gateway/dist ./dist
COPY --from=builder /app/package*.json ./

# Create audio storage
RUN mkdir -p /tmp/wise2-phone-audio

# Environment
ENV NODE_ENV=production \
    PORT=3001 \
    LOG_LEVEL=info

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Use tini to handle signals properly
ENTRYPOINT ["/sbin/tini", "--"]

# Run
CMD ["node", "dist/index.js"]
