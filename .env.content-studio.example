# ============================================================================
# WISE² Faceless Content Studio — Environment Configuration
# ============================================================================

# Core Features
CONTENT_STUDIO_ENABLED=true
CONTENT_MAX_BATCH_SIZE=30
CONTENT_MAX_VIDEO_SECONDS=90
CONTENT_DAILY_COST_LIMIT=100
CONTENT_MONTHLY_COST_LIMIT=500

# ============================================================================
# Discord Configuration
# ============================================================================

# Role IDs for access control (optional — if empty, all users allowed)
DISCORD_CONTENT_ADMIN_ROLE_ID=
DISCORD_CONTENT_CREATOR_ROLE_ID=
DISCORD_CONTENT_APPROVER_ROLE_ID=
DISCORD_CONTENT_PUBLISHER_ROLE_ID=

# Channel IDs for content pipeline (optional)
DISCORD_CONTENT_STUDIO_CHANNEL_ID=
DISCORD_CONTENT_APPROVAL_CHANNEL_ID=
DISCORD_CONTENT_OUTPUT_CHANNEL_ID=
DISCORD_CONTENT_ERRORS_CHANNEL_ID=

# ============================================================================
# AI Providers (Text Generation)
# ============================================================================

# Primary provider (Anthropic Claude)
# Get key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk_ant_XXXXXXXXXXXXXXXXXXXXX

# Fallback provider 1 (OpenAI)
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj_XXXXXXXXXXXXXXXXXXXXX

# Fallback provider 2 (Ollama — local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# ============================================================================
# Voice Generation
# ============================================================================

# ElevenLabs for high-quality voiceovers
# Get key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=rachel

# ============================================================================
# Image & Video Generation
# ============================================================================

# FAL AI for advanced image/video generation
# Get key from: https://fal.ai/
FAL_KEY=

# ============================================================================
# File Storage (S3 or S3-compatible)
# ============================================================================

CONTENT_STORAGE_PROVIDER=s3                    # Options: s3, local
CONTENT_STORAGE_BUCKET=wise2-content
CONTENT_STORAGE_ENDPOINT=                      # Leave blank for AWS; set for MinIO/DigitalOcean Spaces
CONTENT_STORAGE_REGION=us-east-1
CONTENT_STORAGE_ACCESS_KEY=
CONTENT_STORAGE_SECRET_KEY=
CONTENT_PUBLIC_BASE_URL=https://content.wise2.net

# ============================================================================
# FFmpeg Configuration
# ============================================================================

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ============================================================================
# Render Configuration
# ============================================================================

# Maximum time for a single video render (milliseconds)
CONTENT_MAX_RENDER_TIMEOUT_MS=600000          # 10 minutes

# Maximum file size for individual assets (MB)
CONTENT_MAX_ASSET_SIZE_MB=500

# ============================================================================
# Redis Configuration (for job queue)
# ============================================================================

# Already configured via REDIS_URL in main .env
# REDIS_URL=redis://:password@redis:6379

# ============================================================================
# Command Center Configuration
# ============================================================================

# Already configured via COMMAND_CENTER_URL in services/wise-discord/bot.js
# COMMAND_CENTER_URL=http://127.0.0.1:3004
# EVENTS_SECRET=your_events_secret_here
