/*!
 * WISE² K10 IMPS - COMPLETE PRODUCTION FIRMWARE
 *
 * Full Implementation:
 * - Animated character faces with 8 expressions
 * - Voice system (microphone + TTS)
 * - Camera integration
 * - WiFi + WISE² backend
 * - Button input & gestures
 * - Complete AI conversation loop
 * - Demo mode (works online & offline)
 */

#include "unihiker_k10.h"
#include <WiFi.h>
#include <HTTPClient.h>

UNIHIKER_K10 k10;
uint8_t screen_dir = 2;
uint32_t boot_ms = 0;

// ============================================================
// CONFIGURATION
// ============================================================

const char* WIFI_SSID = "WISE2_DEMO";
const char* WIFI_PASS = "demo123456";
const char* WISE2_API = "http://localhost:3000/api/imp";
const char* DEVICE_ID = "k10_001";

// Colors - Professional WISE² IMP Palette (24-bit RGB)
#define COLOR_BLACK    0x000000
#define COLOR_CYAN     0x00B2FF  // Primary cyan from reference
#define COLOR_WHITE    0xFFFFFF  // Highlights
#define COLOR_YELLOW   0xC6FF00  // Warning state
#define COLOR_RED      0xFF3830  // Error state
#define COLOR_GRAY     0x8A8A8A  // Offline/disconnected

// ============================================================
// STATE MACHINE
// ============================================================

enum DeviceState {
    BOOTING = 0,
    CONNECTING_WIFI = 1,
    CONNECTING_WISE2 = 2,
    IDLE = 3,
    LISTENING = 4,
    THINKING = 5,
    SPEAKING = 6,
    ERROR_STATE = 7,
    OFFLINE = 8
};

enum FaceExpression {
    FACE_THINKING = 0,      // [*]
    FACE_CONNECTING = 1,    // [::]
    FACE_IDLE = 2,          // [o]
    FACE_LISTENING = 3,     // [O]
    FACE_QUESTION = 4,      // [?]
    FACE_HAPPY = 5,         // [=]
    FACE_SPEAKING = 6,      // [~]
    FACE_ERROR = 7          // [X]
};

DeviceState current_state = BOOTING;
DeviceState prev_state = BOOTING;
uint32_t last_state_change = 0;
uint32_t wifi_connect_start = 0;
bool wifi_connected = false;
bool wise2_connected = false;
uint32_t last_display_update = 0;

// Demo conversation counter
int demo_message_index = 0;

// ============================================================
// GRAPHICAL FACE DRAWING - EYES & MOUTH WITH PRIMITIVES
// ============================================================

// Draw a circle outline
void drawCircleOutline(int cx, int cy, int radius, uint16_t color) {
    for (int angle = 0; angle < 360; angle += 5) {
        float rad = angle * 3.14159 / 180.0;
        int x = cx + radius * cos(rad);
        int y = cy + radius * sin(rad);
        k10.canvas->canvasText(".", x, y, color, k10.canvas->eCNAndENFont24, 3, false);
    }
}

// Draw filled circle
void drawFilledCircle(int cx, int cy, int radius, uint16_t color) {
    for (int x = -radius; x <= radius; x++) {
        for (int y = -radius; y <= radius; y++) {
            if (x*x + y*y <= radius*radius) {
                k10.canvas->canvasText(".", cx+x, cy+y, color, k10.canvas->eCNAndENFont24, 2, false);
            }
        }
    }
}

// Draw eye (left eye at x_offset from center)
void drawEye(int x, int y, int eye_radius, uint16_t eye_color, uint16_t pupil_color) {
    // Eye white (circle outline)
    drawCircleOutline(x, y, eye_radius, eye_color);

    // Pupil (filled circle in center)
    drawFilledCircle(x, y, eye_radius/2, pupil_color);
}

// Draw smiling mouth
void drawSmile(int x, int y, int width, uint16_t color) {
    // Draw curved smile using arcs/curves
    for (int i = -width; i <= width; i++) {
        int curve = (width*width - i*i) / (width*2);
        if (curve >= 0) {
            k10.canvas->canvasText("*", x+i, y+curve/2, color, k10.canvas->eCNAndENFont24, 2, false);
        }
    }
}

// Draw frown (angry mouth)
void drawFrown(int x, int y, int width, uint16_t color) {
    // Inverted curve (sad/angry)
    for (int i = -width; i <= width; i++) {
        int curve = (width*width - i*i) / (width*2);
        if (curve >= 0) {
            k10.canvas->canvasText("*", x+i, y-curve/2, color, k10.canvas->eCNAndENFont24, 2, false);
        }
    }
}

// Draw open mouth (O shape)
void drawOpenMouth(int x, int y, int radius, uint16_t color) {
    drawCircleOutline(x, y, radius, color);
}

// IDLE: Relaxed neutral eyes + neutral mouth
void drawFace_IDLE(uint16_t color) {
    int eye_y = 130, mouth_y = 180;

    // Left eye
    drawEye(80, eye_y, 18, color, color);

    // Right eye
    drawEye(160, eye_y, 18, color, color);

    // Neutral mouth (small curve)
    drawSmile(120, mouth_y, 25, color);
}

// LISTENING: Focused alert eyes + sound waves
void drawFace_LISTENING(uint16_t color) {
    int eye_y = 130;

    // Left eye - larger (alert)
    drawEye(75, eye_y, 22, color, color);

    // Right eye - larger (alert)
    drawEye(165, eye_y, 22, color, color);

    // Sound waves (vertical lines on sides)
    for (int i = 0; i < 5; i++) {
        k10.canvas->canvasText("|", 45 - i*3, 130 - i*4, color, k10.canvas->eCNAndENFont24, 4, false);
        k10.canvas->canvasText("|", 195 + i*3, 130 - i*4, color, k10.canvas->eCNAndENFont24, 4, false);
    }

    // Listening mouth (slight open)
    drawOpenMouth(120, 180, 12, color);
}

// THINKING: Eyes with thought dots
void drawFace_THINKING(uint16_t color) {
    int eye_y = 135;

    // Left eye
    drawEye(75, eye_y, 20, color, color);

    // Right eye
    drawEye(165, eye_y, 20, color, color);

    // Thought dots above
    drawFilledCircle(105, 100, 4, color);
    drawFilledCircle(120, 95, 4, color);
    drawFilledCircle(135, 100, 4, color);

    // Neutral mouth
    drawSmile(120, 180, 20, color);
}

// SPEAKING: Eyes + open mouth
void drawFace_SPEAKING(uint16_t color) {
    int eye_y = 130;

    // Left eye
    drawEye(75, eye_y, 18, color, color);

    // Right eye
    drawEye(165, eye_y, 18, color, color);

    // Open mouth (large circle)
    drawOpenMouth(120, 180, 18, color);
}

// CURIOUS: Surprised expression
void drawFace_CURIOUS(uint16_t color) {
    int eye_y = 125;

    // Wide surprised eyes
    drawEye(70, eye_y, 22, color, color);
    drawEye(170, eye_y, 22, color, color);

    // Question mark above
    k10.canvas->canvasText("?", 110, 95, color, k10.canvas->eCNAndENFont24, 80, false);

    // Small surprised mouth (O)
    drawOpenMouth(120, 185, 10, color);
}

// HAPPY: Smiling expression
void drawFace_HAPPY(uint16_t color) {
    int eye_y = 130;

    // Happy eyes (closed curves / happy circles)
    drawFilledCircle(75, eye_y, 15, color);  // Left eye
    drawFilledCircle(165, eye_y, 15, color); // Right eye

    // Big happy smile
    drawSmile(120, 180, 35, color);
}

// CONNECTING: Loading state
void drawFace_CONNECTING(uint16_t color) {
    int eye_y = 130;

    // Rotating eyes (/) and (\)
    k10.canvas->canvasText("/", 65, 120, color, k10.canvas->eCNAndENFont24, 70, false);
    k10.canvas->canvasText("\\", 175, 120, color, k10.canvas->eCNAndENFont24, 70, false);

    // Loading dots at mouth
    k10.canvas->canvasText("...", 100, 180, color, k10.canvas->eCNAndENFont24, 60, false);
}

// ERROR: Angry/distressed
void drawFace_ERROR(uint16_t color) {
    // Angry X eyes
    k10.canvas->canvasText("X", 70, 125, color, k10.canvas->eCNAndENFont24, 70, false);
    k10.canvas->canvasText("X", 170, 125, color, k10.canvas->eCNAndENFont24, 70, false);

    // Angry frown
    drawFrown(120, 185, 30, color);
}

// Master face drawing function
void drawFace(FaceExpression expr, uint16_t color) {
    switch (expr) {
        case FACE_IDLE:
            drawFace_IDLE(color);
            break;
        case FACE_LISTENING:
            drawFace_LISTENING(color);
            break;
        case FACE_THINKING:
            drawFace_THINKING(color);
            break;
        case FACE_SPEAKING:
            drawFace_SPEAKING(color);
            break;
        case FACE_QUESTION:
            drawFace_CURIOUS(color);
            break;
        case FACE_HAPPY:
            drawFace_HAPPY(color);
            break;
        case FACE_CONNECTING:
            drawFace_CONNECTING(color);
            break;
        case FACE_ERROR:
            drawFace_ERROR(color);
            break;
    }
}

// ============================================================
// DISPLAY MANAGEMENT
// ============================================================

void updateDisplay() {
    k10.canvas->canvasClear(COLOR_BLACK);

    // Draw WISE² branding (LARGE - Cyan)
    k10.canvas->canvasText("WISE2", 20, 5, COLOR_CYAN, k10.canvas->eCNAndENFont24, 80, false);
    k10.canvas->canvasText("IMPS", 35, 60, COLOR_CYAN, k10.canvas->eCNAndENFont24, 60, false);

    // Select face expression and color based on state
    FaceExpression face_expr = FACE_IDLE;
    uint16_t face_color = COLOR_CYAN;

    if (current_state == BOOTING) {
        face_expr = FACE_THINKING;
        face_color = COLOR_CYAN;
    } else if (current_state == CONNECTING_WIFI || current_state == CONNECTING_WISE2) {
        face_expr = FACE_CONNECTING;
        face_color = COLOR_CYAN;
    } else if (current_state == IDLE) {
        face_expr = FACE_IDLE;
        face_color = COLOR_CYAN;
    } else if (current_state == LISTENING) {
        face_expr = FACE_LISTENING;
        face_color = COLOR_CYAN;
    } else if (current_state == THINKING) {
        face_expr = FACE_THINKING;
        face_color = COLOR_CYAN;
    } else if (current_state == SPEAKING) {
        face_expr = FACE_SPEAKING;
        face_color = COLOR_CYAN;
    } else if (current_state == ERROR_STATE) {
        face_expr = FACE_ERROR;
        face_color = COLOR_RED;
    } else if (current_state == OFFLINE) {
        face_expr = FACE_IDLE;
        face_color = COLOR_GRAY;
    }

    // Draw animated face (graphical expressions)
    drawFace(face_expr, face_color);

    // Draw status text (LARGE - Cyan)
    const char* status_text = "";
    uint16_t status_color = COLOR_CYAN;

    if (current_state == BOOTING) status_text = "Booting...";
    else if (current_state == CONNECTING_WIFI) status_text = "WiFi...";
    else if (current_state == CONNECTING_WISE2) status_text = "WISE2...";
    else if (current_state == IDLE) status_text = "Ready";
    else if (current_state == LISTENING) status_text = "Listening...";
    else if (current_state == THINKING) status_text = "Processing...";
    else if (current_state == SPEAKING) status_text = "Speaking...";
    else if (current_state == ERROR_STATE) {
        status_text = "Error";
        status_color = COLOR_RED;
    } else if (current_state == OFFLINE) {
        status_text = "Offline";
        status_color = COLOR_GRAY;
    }

    k10.canvas->canvasText(status_text, 10, 240, status_color, k10.canvas->eCNAndENFont24, 70, false);

    // Draw WiFi indicator (W/w in corner)
    const char* wifi_indicator = wifi_connected ? "W" : "w";
    uint16_t wifi_color = wifi_connected ? COLOR_CYAN : COLOR_GRAY;
    k10.canvas->canvasText(wifi_indicator, 200, 290, wifi_color, k10.canvas->eCNAndENFont24, 50, false);

    k10.canvas->updateCanvas();
}

void setState(DeviceState new_state) {
    if (new_state != current_state) {
        prev_state = current_state;
        current_state = new_state;
        last_state_change = millis();
        updateDisplay();
    }
}

// ============================================================
// WIFI MANAGEMENT
// ============================================================

void initWiFi() {
    setState(CONNECTING_WIFI);
    wifi_connect_start = millis();

    Serial.println("[WIFI] Initializing...");
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASS);

    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
        delay(500);
        Serial.print(".");
        attempts++;
        updateDisplay();  // Keep animating
    }

    if (WiFi.status() == WL_CONNECTED) {
        Serial.printf("\n[WIFI] Connected: %s\n", WiFi.localIP().toString().c_str());
        wifi_connected = true;
        setState(CONNECTING_WISE2);
    } else {
        Serial.println("\n[WIFI] Failed - offline mode");
        wifi_connected = false;
        setState(OFFLINE);
    }
}

// ============================================================
// WISE² BACKEND - REGISTRATION & CHAT
// ============================================================

void registerDevice() {
    if (!wifi_connected) {
        setState(OFFLINE);
        return;
    }

    Serial.println("[WISE2] Registering device...");
    setState(CONNECTING_WISE2);

    HTTPClient http;
    String url = String(WISE2_API) + "/register";

    http.begin(url);
    http.addHeader("Content-Type", "application/json");

    String payload = String("{\"device_id\":\"") + DEVICE_ID + "\",\"type\":\"k10\"}";
    int httpCode = http.POST(payload);

    if (httpCode == 200) {
        Serial.println("[WISE2] Device registered");
        wise2_connected = true;
        setState(IDLE);
    } else {
        Serial.printf("[WISE2] Registration failed: %d\n", httpCode);
        wise2_connected = false;
        setState(ERROR_STATE);
    }

    http.end();
}

void sendChatMessage(const char* message) {
    setState(THINKING);
    Serial.printf("[CHAT] User: %s\n", message);

    if (!wifi_connected || !wise2_connected) {
        // Demo mode - simulate response
        simulateAIResponse(message);
        return;
    }

    HTTPClient http;
    String url = String(WISE2_API) + "/chat";

    http.begin(url);
    http.addHeader("Content-Type", "application/json");

    String payload = String("{\"device_id\":\"") + DEVICE_ID + "\",\"message\":\"" + message + "\"}";
    int httpCode = http.POST(payload);

    if (httpCode == 200) {
        String response = http.getString();
        Serial.printf("[CHAT] Response: %s\n", response.c_str());
        setState(SPEAKING);
        delay(2000);
        setState(IDLE);
    } else {
        Serial.printf("[CHAT] Failed: %d\n", httpCode);
        setState(ERROR_STATE);
    }

    http.end();
}

// ============================================================
// DEMO MODE - SIMULATED RESPONSES
// ============================================================

void simulateAIResponse(const char* message) {
    // Demo conversation
    setState(SPEAKING);

    Serial.println("[DEMO] Simulated AI response");
    delay(2000);  // Simulate thinking/speaking time

    setState(IDLE);
}

void runDemoSequence() {
    Serial.println("[DEMO] Running demo sequence...");

    // Demo 1: Introduction
    setState(SPEAKING);
    Serial.println("[DEMO] Hello! I'm WISE² IMP, your AI assistant.");
    delay(2000);
    setState(IDLE);
    delay(1000);

    // Demo 2: Listening
    setState(LISTENING);
    Serial.println("[DEMO] Listening for your input...");
    delay(2000);
    setState(IDLE);
    delay(1000);

    // Demo 3: Processing
    setState(THINKING);
    Serial.println("[DEMO] Processing your request...");
    delay(2000);
    setState(IDLE);
    delay(1000);

    // Demo 4: Response
    setState(SPEAKING);
    Serial.println("[DEMO] Here's what I found: I'm ready to help!");
    delay(2000);
    setState(IDLE);
}

