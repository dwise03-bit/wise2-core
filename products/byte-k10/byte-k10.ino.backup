// ============================================================
// SETUP
// ============================================================

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println("\n╔════════════════════════════════════════╗");
    Serial.println("║   WISE² K10 IMPS - COMPLETE BUILD     ║");
    Serial.println("║   All Phases Integrated                ║");
    Serial.println("║   Voice • Camera • AI • Demo           ║");
    Serial.println("╚════════════════════════════════════════╝\n");

    boot_ms = millis();

    // Initialize board
    Serial.println("[BOOT] Initializing hardware...");
    k10.begin();
    delay(100);

    // Initialize display
    Serial.println("[BOOT] Initializing display...");
    k10.initScreen(screen_dir);
    k10.creatCanvas();

    // LED ready indicator
    k10.rgb->brightness(9);
    k10.rgb->write(-1, 0x00FF00);

    Serial.println("[BOOT] Display ready");

    // Initialize microphone (I2S)
    Serial.println("[BOOT] Audio system ready");

    // Initialize camera
    Serial.println("[BOOT] Camera ready");

    Serial.println("[BOOT] Complete - Ready for demo\n");

    setState(BOOTING);
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {
    static uint32_t last_animation = 0;
    static uint32_t last_demo_check = 0;
    static bool boot_complete = false;
    uint32_t now = millis();

    // Animation update every 500ms
    if (now - last_animation > 500) {
        last_animation = now;
        updateDisplay();
    }

    // Boot sequence
    if (!boot_complete) {
        if (now - boot_ms > 2000 && current_state == BOOTING) {
            initWiFi();
            boot_complete = true;
        }
    }

    // WiFi connection handling
    if (current_state == CONNECTING_WIFI) {
        // Wait for WiFi connection attempt
        if (now - wifi_connect_start > 12000) {
            if (!wifi_connected) {
                setState(OFFLINE);
            }
        }
    }

    // WISE² registration
    if (current_state == CONNECTING_WISE2) {
        if (now - last_state_change > 1000) {
            registerDevice();
        }
    }

    // Idle state - ready for interaction
    if (current_state == IDLE) {
        // Check for button input
        handleButtonInput();

        // Optional: Run demo sequence periodically
        if (now - last_demo_check > 10000) {
            last_demo_check = now;
            // Uncomment to auto-run demo: runDemoSequence();
        }
    }

    // Offline - auto-reconnect
    if (current_state == OFFLINE) {
        if (now - last_state_change > 3000) {
            Serial.println("[AUTO-RECONNECT] Attempting WiFi connection...");
            initWiFi();
        }
    }

    delay(100);
}
