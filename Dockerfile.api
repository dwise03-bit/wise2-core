# NestJS API Dockerfile
# Force rebuild: Discord module disabled 2026-08-27
FROM node:20-slim

WORKDIR /app

# Install runtime dependencies for Prisma (openssl 1.1 for linux-musl binary)
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@8.15.9

# Copy all package.json files for workspace resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/ai-phone/package.json ./packages/ai-phone/
COPY packages/agent-framework/package.json ./packages/agent-framework/
COPY packages/db/prisma ./packages/db/prisma

# Install ALL workspace dependencies
RUN pnpm install --shamefully-hoist --recursive

# Generate Prisma client for current environment (linux-musl)
RUN cd packages/db && pnpm exec prisma generate

# Copy all source files (minimal)
COPY packages/api ./packages/api
COPY packages/db/prisma ./packages/db/prisma

# Install ts-node globally for direct TypeScript execution
RUN npm install -g ts-node typescript

EXPOSE 3000

# Set NODE_PATH to find hoisted node_modules and run from root
ENV NODE_PATH=/app/node_modules
ENV TS_NODE_TRANSPILE_ONLY=true
ENV TS_NODE_SKIP_PROJECT=true
WORKDIR /app

# Run with ts-node with transpile-only to skip type checking
ENTRYPOINT []
CMD ["ts-node", "--transpile-only", "packages/api/src/main.ts"]
