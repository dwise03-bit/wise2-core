# NestJS API Dockerfile
# Force rebuild: Discord module disabled 2026-08-27
FROM node:20-slim

WORKDIR /app

# Install runtime dependencies for Prisma (openssl 1.1 for linux-musl binary)
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@8.15.9

# Copy all package.json files for workspace resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/ai-phone/package.json ./packages/ai-phone/
COPY packages/agent-framework/package.json ./packages/agent-framework/
COPY packages/db/prisma ./packages/db/prisma

# Install ALL workspace dependencies
RUN pnpm install --shamefully-hoist --recursive

# Generate Prisma client for current environment (linux-musl)
RUN cd packages/db && pnpm exec prisma generate

# Copy API source (skip TypeScript compilation - use ts-node at runtime)
COPY packages/api/src ./packages/api/src
COPY packages/api/tsconfig.json ./packages/api/
COPY packages/ai-phone/src ./packages/ai-phone/src
COPY packages/ai-phone/tsconfig.json ./packages/ai-phone/
COPY packages/agent-framework/src ./packages/agent-framework/src
COPY packages/agent-framework/tsconfig.json ./packages/agent-framework/

# Just ensure ts-node and ts-node-dev are available
RUN npm install -g ts-node @types/node

EXPOSE 3000

# Run with ts-node to bypass TypeScript compilation issues
ENTRYPOINT []
CMD ["node", "--loader=ts-node/esm", "--experimental-specifier-resolution=node", "packages/api/src/main.ts"]
