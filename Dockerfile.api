# NestJS API Dockerfile
# Force rebuild: Discord module disabled 2026-08-27
FROM node:20-slim

WORKDIR /app

# Install runtime dependencies for Prisma (openssl 1.1 for linux-musl binary)
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@8.15.9

# Copy all package.json files for workspace resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/ai-phone/package.json ./packages/ai-phone/
COPY packages/agent-framework/package.json ./packages/agent-framework/
COPY packages/db/prisma ./packages/db/prisma

# Install ALL workspace dependencies
RUN pnpm install --shamefully-hoist --recursive

# Generate Prisma client for current environment (linux-musl)
RUN cd packages/db && pnpm exec prisma generate

# Copy API source for compilation
COPY packages/api/src ./packages/api/src
COPY packages/api/tsconfig.json ./packages/api/

# Compile API with tsc (skip other packages to avoid type errors)
RUN cd packages/api && npx tsc --skipLibCheck --noEmit false --outDir dist

EXPOSE 3000

# Run compiled API
ENTRYPOINT []
CMD ["node", "packages/api/dist/main.js"]
