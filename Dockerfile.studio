# Studio App Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID

COPY package*.json ./
COPY apps/studio/package.json ./apps/studio/
RUN npm install

COPY apps/studio ./apps/studio
RUN npm run build

# Production image
FROM node:18-alpine

WORKDIR /app

COPY --from=builder /app/apps/studio/.next ./apps/studio/.next
COPY --from=builder /app/apps/studio/package.json ./apps/studio/
COPY package*.json ./

RUN cd apps/studio && npm install --production

EXPOSE 3005

CMD ["npm", "--prefix", "apps/studio", "start", "--", "-p", "3005"]
