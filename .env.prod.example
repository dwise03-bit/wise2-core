# WISE² Production Environment Variables
# Copy to .env.prod and fill in actual values

# Database
DATABASE_PASSWORD=change_me_production_password
DB_USER=wise2
DB_NAME=wise2_prod

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT
JWT_SECRET=change_me_jwt_secret_key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@wise2.net

# URLs
APP_URL=https://wise2.net
API_BASE_URL=https://api.wise2.net
NEXT_PUBLIC_API_URL=https://api.wise2.net
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.wise2.net
NEXT_PUBLIC_SITE_URL=https://wise2.net

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL_API=https://api.wise2.net/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI_WEBSITE=https://wise2.net/api/auth/google/callback

# Discord
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...
DISCORD_BOT_TOKEN=...
DISCORD_BOT_CLIENT_ID=1512638268225622147
DISCORD_GUILD_ID=...
DISCORD_WEBHOOK_URL=...
DISCORD_REDIRECT_URI=https://wise2.net/api/auth/discord/callback

# Stripe Public Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_...

# LLM Configuration
OLLAMA_BASE_URL=http://ollama:11435
HERMES_ENDPOINT=http://ollama:11435/v1/chat/completions
OLLAMA_CHAT_MODEL=mistral:latest
OLLAMA_GRAPHICS_MODEL=mistral:latest
HERMES_TIMEOUT_MS=90000

# YouTube (Optional)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=...
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=...
NEXT_PUBLIC_YOUTUBE_DEMO_VIDEO_ID=...
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=...
NEXT_PUBLIC_YOUTUBE_API_KEY=...

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=...
