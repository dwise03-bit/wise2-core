{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WISE2 Cinematic Asset",
  "type": "object",
  "required": ["id", "priority", "purpose", "section", "aspect_ratio", "target_resolution", "variants", "motion", "method"],
  "properties": {
    "id": {"type":"string", "pattern":"^[a-z0-9]+(?:-[a-z0-9]+)+-v[0-9]{2}$"},
    "priority": {"enum":["MUST HAVE", "SHOULD HAVE", "OPTIONAL"]},
    "purpose": {"type":"string"}, "section":{"type":"string"}, "aspect_ratio":{"type":"string"}, "target_resolution":{"type":"string"},
    "variants":{"type":"array", "minItems":1, "items":{"enum":["desktop", "tablet", "mobile"]}},
    "motion":{"enum":["static", "animated"]}, "method":{"enum":["photography", "3d-render", "image-generation", "video-generation", "compositing", "code"]},
    "dependencies":{"type":"array", "items":{"type":"string"}}
  }
}
