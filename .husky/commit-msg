#!/bin/sh
# Commit message hook for WISE² Git workflow
# Enforces conventional commits format
# Install: ./scripts/setup-git-hooks.sh

COMMIT_MSG_FILE=$1

# Read the commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Allow merge commits
if echo "$COMMIT_MSG" | grep -q "^Merge branch"; then
    exit 0
fi

# Allow revert commits
if echo "$COMMIT_MSG" | grep -q "^Revert"; then
    exit 0
fi

# Check format: type(scope): description
if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|chore|docs|style|refactor|perf|test|ci|security|build|revert)\(.+\): .{10,}"; then
    echo "❌ Invalid commit message format!"
    echo ""
    echo "Format: type(scope): description"
    echo ""
    echo "Valid types:"
    echo "  feat     - New feature"
    echo "  fix      - Bug fix"
    echo "  chore    - Maintenance (deps, cleanup)"
    echo "  docs     - Documentation"
    echo "  refactor - Code restructuring"
    echo "  perf     - Performance improvement"
    echo "  test     - Test additions/changes"
    echo "  ci       - CI/CD changes"
    echo "  security - Security fixes"
    echo ""
    echo "Examples:"
    echo "  feat(tailscale): add user to ACL"
    echo "  fix(github): correct permission sync"
    echo "  chore(deps): update npm packages"
    echo ""
    exit 1
fi

# Check for minimum length
if ! echo "$COMMIT_MSG" | grep -qE "^.{10,}"; then
    echo "❌ Commit message too short (min 10 chars)"
    exit 1
fi

exit 0
