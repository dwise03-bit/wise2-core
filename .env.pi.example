# WISE² Raspberry Pi Environment Configuration
# Copy to .env.pi and customize for your Pi deployment
#
# Usage: docker-compose --env-file .env.pi -f docker-compose.pi.yml up -d

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL password - change to a secure value!
# Generated example: openssl rand -base64 32
DATABASE_PASSWORD=wise2secure_change_me_in_production

# ============================================================================
# STRIPE PAYMENT INTEGRATION (Optional)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_STARTER_PRICE_ID=price_starter_id_here
STRIPE_PRO_PRICE_ID=price_pro_id_here

# ============================================================================
# SENDGRID EMAIL INTEGRATION (Optional)
# ============================================================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@wise2.com

# ============================================================================
# APPLICATION URLS
# ============================================================================
# Replace with your Pi's actual IP or domain
# Examples:
#   Local network: http://192.168.1.100
#   Domain: https://api.wise2.local
#   Cloud: https://api.wise2.cloud

# External URL for API (what clients use)
API_BASE_URL=http://192.168.1.100:3000

# External URL for website/app (what clients use)
APP_URL=http://192.168.1.100:3001

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================

# Log level: debug, info (default), warn, error
LOG_LEVEL=info

# Node.js max memory (should not exceed physical RAM available)
# Default: 256MB for API, 192MB for website
# Increase only if Pi has 4GB+ RAM
# NODE_OPTIONS=--max-old-space-size=512

# ============================================================================
# OPTIONAL: DATABASE PERFORMANCE TUNING
# ============================================================================
# Only change if you understand PostgreSQL tuning
# Database connection pool: min-max
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=5

# Query timeout in milliseconds (30000 = 30 seconds)
# DB_QUERY_TIMEOUT_MS=10000

# ============================================================================
# OPTIONAL: DOCKER BUILD PARAMETERS
# ============================================================================
# Architecture target (usually arm32v7 for Pi 3B/4, arm64v8 for Pi 4 64-bit)
# DOCKER_BUILDKIT=1
# BUILDKIT_PROGRESS=plain

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit this file to git (it's in .gitignore)
# 2. Change all passwords before production deployment
# 3. Use HTTPS in production (configure reverse proxy)
# 4. Rotate API keys regularly
# 5. Keep Docker images updated: docker pull && docker-compose up -d
#
# Generate secure password: openssl rand -base64 32
# Generate secure API key: head -c 32 /dev/urandom | base64
#
