  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([digitalTwinId])
  @@map("DigitalTwinKnowledgeItem")
}

model DigitalTwinConsent {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  digitalTwinId String      @map("digital_twin_id")
  digitalTwin   DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)

  consentType DigitalTwinConsentType @map("consent_type")
  granted     Boolean
  grantedBy   String?                @map("granted_by")
  grantedAt   DateTime?              @map("granted_at")
  revokedAt   DateTime?              @map("revoked_at")
  sourceAsset String?                @map("source_asset")
  version     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([digitalTwinId])
  @@index([tenantId, consentType])
  @@map("DigitalTwinConsent")
}

enum MembershipStatus {
  NONE
  ACTIVE
  EXPIRED
  CANCELED
}

// End-customer of a tenant (e.g. a homeowner served by Wise HVAC).
// Distinct from the existing `Customer` model, which holds WISE²'s own
// consulting clients and is not tenant-scoped.
model RevenueCustomer {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  firstName String?
  lastName  String?
  phone     String?
  email     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  systemType   String?
  equipmentAge Int?

  membershipStatus MembershipStatus @default(NONE)
  tags             String[]         @default([])
  notes            String?          @db.Text

  lastServicedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads          Lead[]
  conversations  Conversation[]
  serviceJobs    ServiceJob[]
  estimates      Estimate[]
  consentRecords ConsentRecord[]
  contracts      Contract[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, membershipStatus])
}

enum LeadStatus {
  NEW
  CONTACTING
  QUALIFIED
  BOOKED
  ESTIMATE
  WON
  LOST
  NURTURE
}

enum LeadUrgency {
  EMERGENCY
  SAME_DAY
  THIS_WEEK
  FLEXIBLE
}

// HVAC-specific intent classification (Phase 4). Namespaced and nullable so
// non-HVAC tenants simply leave it unset.
enum HvacServiceCategory {
  NO_COOLING
  NO_HEAT
  PREVENTATIVE_MAINTENANCE
  THERMOSTAT
  WATER_OR_CONDENSATE_LEAK
  INDOOR_AIR_QUALITY
  EQUIPMENT_REPLACEMENT
  COMMERCIAL_HVAC
  BILLING
  OTHER
}

model Lead {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  customerId String?
  campaignId String?

  source       String
  serviceType  String?
  hvacCategory HvacServiceCategory?

  // Vertical-agnostic classification, keyed against VerticalTemplate.categories
  // for the tenant's vertical. Non-HVAC tenants classify leads here instead of
  // hvacCategory, which stays HVAC-only.
  serviceCategory String?

  urgency LeadUrgency @default(FLEXIBLE)
  status  LeadStatus  @default(NEW)

  summary        String?  @db.Text
  estimatedValue Decimal? @db.Decimal(12, 2)

  bookedAt   DateTime?
  wonAt      DateTime?
  lostReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      RevenueCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  serviceJobs   ServiceJob[]
  estimates     Estimate[]
  safetyEvents  SafetyEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([campaignId])
  @@index([customerId])
}

enum ConversationChannel {
  PHONE
  SMS
  EMAIL
  WEBCHAT
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

model Conversation {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  customerId String?
  leadId     String?

  channel   ConversationChannel
  direction ConversationDirection

  fromValue  String?
  toValue    String?
  body       String? @db.Text
  transcript String? @db.Text

  aiHandled    Boolean      @default(false)
  consentState ConsentState @default(UNKNOWN)

  // Provider-side id, used together with WebhookEvent for idempotency.
  externalProviderId String?

  createdAt DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer RevenueCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([leadId])
  @@index([customerId])
  @@index([externalProviderId])
}

enum ServiceJobStatus {
  SCHEDULED
  DISPATCHED
  ON_SITE
  COMPLETED
  CANCELED
}

// Named ServiceJob rather than Job to avoid ambiguity with BullMQ jobs and
// the existing ContentPublishJob model.
model ServiceJob {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  customerId String?
  leadId     String?

  serviceType    String?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  technician     String?

  status ServiceJobStatus @default(SCHEDULED)
  notes  String?          @db.Text

  revenue Decimal? @db.Decimal(12, 2)

  // Source attribution preserved on the job so completed revenue can be
  // traced back to the originating campaign without re-joining the lead.
  sourceAttribution String?
  campaignId        String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer RevenueCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledStart])
  @@index([leadId])
  @@index([customerId])
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  SOLD
  DECLINED
  EXPIRED
}

model Estimate {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  customerId String?
  leadId     String?

  amount Decimal        @db.Decimal(12, 2)
  status EstimateStatus @default(DRAFT)

  followUpAt DateTime?
  soldAt     DateTime?

  // Objection captured by WISE Recovery; pricing exceptions route to a human.
  objection String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer RevenueCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, followUpAt])
  @@index([leadId])
}

model Campaign {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  platform           String
  campaignName       String
  externalCampaignId String?

  spend  Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, platform, externalCampaignId])
  @@index([tenantId])
  @@index([tenantId, active])
}

enum AgentType {
  RECEPTIONIST
  SPEED_TO_LEAD
  BOOKING
  RECOVERY
  MEMBERSHIP
  REVIEW
  REACTIVATION
}

enum AgentStatus {
  ONLINE
  PAUSED
  ERROR
  NEEDS_CONFIG
}

model AgentConfig {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  type    AgentType
  name    String
  enabled Boolean     @default(false)
  status  AgentStatus @default(NEEDS_CONFIG)

  instructions String? @db.Text
  config       Json?

  // Reference to provider credentials by key, never the secret itself.
  providerConfigRef String?

  lastRunAt DateTime?
  lastError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model AutomationRun {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  workflowKey String
  entityType  String?
  entityId    String?

  status AutomationRunStatus @default(PENDING)

  payload Json?

  startedAt  DateTime?
  finishedAt DateTime?

  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, workflowKey])
  @@index([tenantId, status])
  @@index([entityType, entityId])
}

// Durable webhook idempotency + replay protection (Phase 12).
// Tenant is resolved from trusted provider mapping, never from payload body.
model WebhookEvent {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")

  provider   String
  externalId String

  signatureValid Boolean   @default(false)
  processedAt    DateTime?

  payloadHash String
  error       String? @db.Text

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([tenantId])
  @@index([createdAt])
}

// ============================================================================
// PROVISIONING ENGINE (Phase 1)
// Tracks the multi-step activation of a tenant after payment
// ============================================================================

enum ProvisioningStep {
  CREATE_TENANT
  CREATE_MEMBERSHIP
  INITIALIZE_DATABASE
  LOAD_TEMPLATE
  CREATE_PIPELINE
  CREATE_WORKFLOWS
  INITIALIZE_HERMES
  PROVISION_DISCORD
  START_ONBOARDING
  ACTIVATE
}

enum ProvisioningStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RETRYING
  SKIPPED
}

model ProvisioningRun {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Payment event trigger
  paymentEventId   String?
  paymentEventType String? // e.g., "charge.succeeded", "payment_intent.succeeded"

  // Current state
  currentStep ProvisioningStep   @default(CREATE_TENANT)
  status      ProvisioningStatus @default(PENDING)

  // Progress tracking
  completedSteps ProvisioningStep[]

  // Error recovery
  lastError     String?           @db.Text
  lastErrorStep ProvisioningStep?
  retryCount    Int               @default(0)
  maxRetries    Int               @default(3)

  // Lifecycle
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tenantId, status])
}

// ============================================================================
// APPROVAL ENGINE (Phase 13)
// Safety gate for high-impact external actions
// ============================================================================

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

model Approval {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Request details
  actor    String // User ID who requested
  action   String // What action (send_sms, publish_social, charge_payment)
  target   String // Target entity (Lead, Customer, Estimate)
  targetId String // ID of target entity

  // Payload (encrypted in production)
  payloadHash String @unique // Hash of payload for integrity
  payload     Json // Actual payload
  preview     String @db.Text // Human-readable preview

  // Approval tracking
  status     ApprovalStatus @default(PENDING)
  approver   String? // User ID who approved/rejected
  note       String?        @db.Text
  approvedAt DateTime?

  // Execution
  executedAt      DateTime?
  executionResult Json? // Result of executing approved action
  executionError  String?   @db.Text

  // Lifecycle
  createdAt DateTime @default(now())
  expiresAt DateTime // Approvals expire after 24 hours

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, actor])
  @@index([expiresAt])
}

// ============================================================================
// WORKFLOW ENGINE (Phase 14)
// Declarative automation triggered by events
// ============================================================================

enum WorkflowTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  ESTIMATE_SENT
  ESTIMATE_VIEWED
  JOB_CREATED
  JOB_COMPLETED
  CONVERSATION_RECEIVED
  CAMPAIGN_STARTED
  SCHEDULED_TIME
  MANUAL
}

model WorkflowDefinition {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  description       String?         @db.Text
  trigger           WorkflowTrigger
  triggerConditions Json? // Condition filters (e.g., leadStatus = "NEW")

  // Workflow steps (action pipeline)
  steps Json // Array of {action, params, condition}

  enabled Boolean @default(true)
  order   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs WorkflowRun[]

  @@unique([tenantId, trigger])
  @@index([tenantId])
  @@index([tenantId, enabled])
}

model WorkflowRun {
  id         String             @id @default(cuid())
  workflowId String
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Trigger source
  triggerEntityType String
  triggerEntityId   String

  // Execution
  status  AutomationRunStatus @default(PENDING)
  results Json? // Step results
  error   String?             @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@index([status])
  @@index([triggerEntityType, triggerEntityId])
}

// ============================================================================
// CRM ENHANCEMENTS (Phases 9-11)
// Missing models for complete customer lifecycle
// ============================================================================

enum FollowUpType {
  LEAD_CONTACT
  ESTIMATE_FOLLOW_UP
  JOB_SCHEDULING
  JOB_REMINDER
  POST_SERVICE
  REVIEW_REQUEST
  PAYMENT_REMINDER
  MAINTENANCE_OPPORTUNITY
  REACTIVATION
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

model FollowUp {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  followUpType      FollowUpType
  relatedEntityType String
  relatedEntityId   String

  // Who needs to follow up
  assignedTo String? // User ID

  // What to do
  message  String?  @db.Text
  priority Int      @default(0)
  dueAt    DateTime

  // Status
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@index([relatedEntityType, relatedEntityId])
}

model Contract {
  id         String          @id @default(cuid())
  tenantId   String          @map("tenant_id")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   RevenueCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contractValue Decimal  @db.Decimal(12, 2)
  startDate     DateTime
  renewalDate   DateTime
  frequency     String? // "monthly", "quarterly", "annually", "as-needed"

  services String[] // Array of service names
  status   String   @default("active") // "active", "renewing", "paused", "ended"

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([renewalDate])
}

// ============================================================================
// AUDIT LOG (Phase 17)
// Comprehensive audit trail for compliance
// ============================================================================

model AuditLog {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actor        String // User ID
  action       String // What happened
  resourceType String // What entity
  resourceId   String // Which entity

  changesBefore Json? // Before state
  changesAfter  Json? // After state

  traceId String? // Correlation ID
  source  String? // API, Discord, Webhook, etc.

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actor])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

enum ConsentChannel {
  SMS
  CALL
  EMAIL
}

enum ConsentState {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
  DNC
}

model ConsentRecord {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  customerId String?

  channel ConsentChannel
  state   ConsentState   @default(UNKNOWN)

  // Where the consent signal came from (web form, STOP keyword, call IVR…).
  source String?

  // Raw inbound keyword for STOP/START events, retained for audit.
  keyword String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer RevenueCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId, channel])
  @@index([occurredAt])
}

enum SafetyRiskType {
  GAS_ODOR
  CARBON_MONOXIDE
  SMOKE
  FIRE
  ELECTRICAL_BURNING
  ARCING
  ELECTRICAL_HAZARD
  REFRIGERANT_EXPOSURE
  IMMEDIATE_DANGER
}

// Every safety-gate trip is logged (Phase 4). Presence of a row means normal
// sales/diagnosis flow was halted and the tenant escalation policy applied.
model SafetyEvent {
  id       String  @id @default(cuid())
  tenantId String  @map("tenant_id")
  leadId   String?

  riskType    SafetyRiskType
  matchedTerm String?
  sourceText  String?        @db.Text

  escalated   Boolean @default(false)
  escalatedTo String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, riskType])
  @@index([createdAt])
}

// ============================================================================
// WISE² LIVE™ - Universal Customer Demo Engine
// ============================================================================

// Per-tenant demo environment container
// Every tenant automatically gets a DemoEnvironment when provisioned
model DemoEnvironment {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Brand configuration (inherited from Tenant business profile)
  businessName    String
  ownerName       String?
  businessPhone   String?
  businessEmail   String?
  businessWebsite String?
  industry        String  @default("hvac")
  subIndustry     String?
  logo            String? @db.Text
  brandColors     Json?

  // Demo configuration
  status                DemoEnvironmentStatus @default(ACTIVE)
  communicationMode     CommunicationMode     @default(SIMULATED)
  paymentMode           PaymentMode           @default(SIMULATED)
  allowDemoReset        Boolean               @default(true)
  allowMultipleSessions Boolean               @default(true)

  // Seeded demo data
  demoCustomerCount Int       @default(3)
  demoLeadCount     Int       @default(5)
  demoJobCount      Int       @default(2)
  lastResetAt       DateTime?

  // Tour configuration
  defaultTourId String?
  tourSequence  String[] @default([]) // IDs of tours in order

  // Analytics
  totalSessions     Int    @default(0)
  completedSessions Int    @default(0)
  averageEngagement Float?
  conversionRate    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    DemoSession[]
  scenarios   DemoScenario[]
  tours       DemoTour[]
  events      DemoEvent[]
  conversions DemoConversion[]

  @@index([tenantId])
  @@index([status])
}

enum DemoEnvironmentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CommunicationMode {
  SIMULATED // No external SMS/email calls
  SANDBOX // Twilio test credentials (future)
  LIVE // Real SMS/email (never for demo)
}

enum PaymentMode {
  SIMULATED // No Stripe calls
  STRIPE_TEST // Stripe test mode (future)
  STRIPE_LIVE // Real charges (never for demo)
}

// Demo scenario definitions
// Examples: NEW_LEAD, MISSED_CALL, WEB_FORM, QUOTE_REQUEST, BOOKING, etc
model DemoScenario {
  id                String          @id @default(cuid())
  demoEnvironmentId String          @map("demo_environment_id")
  demoEnvironment   DemoEnvironment @relation(fields: [demoEnvironmentId], references: [id], onDelete: Cascade)

  // Scenario metadata
  key            String // e.g., "NEW_LEAD", "MISSED_CALL"
  name           String // Display name
  description    String? @db.Text
  icon           String? // Icon or emoji
  sequenceNumber Int     @default(0) // Order in scenario list

  // Scenario execution config
  triggerType   String   @default("manual") // manual, automated, scheduled
  duration      Int      @default(30) // seconds to complete
  eventSequence String[] @default([]) // ordered list of event types

  // Industry-specific
  industry        String   @default("hvac")
  applicableRoles String[] @default(["owner", "customer"])

  // Data template
  dataTemplate     Json? // Pre-configured demo data
  expectedOutcomes String[] @default([])

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions DemoSession[]
  events   DemoEvent[]

  @@unique([demoEnvironmentId, key])
  @@index([demoEnvironmentId])
  @@index([industry])
}

// Demo visitor sessions
// One per demo URL visit/sharing
model DemoSession {
  id                String          @id @default(cuid())
  demoEnvironmentId String          @map("demo_environment_id")
  demoEnvironment   DemoEnvironment @relation(fields: [demoEnvironmentId], references: [id], onDelete: Cascade)

  scenarioId String?
  scenario   DemoScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  // Session identity
  sessionToken  String  @unique // Signed, opaque token
  prospectEmail String?
  prospectName  String?

  // Session state
  status         DemoSessionStatus  @default(ACTIVE)
  selectedMode   DemoExperienceMode @default(ENTRY) // customer, owner, automation, ai, etc
  stepsCompleted Int                @default(0)

  // Engagement tracking
  engagementScore  Float    @default(0.0)
  actionsPerformed String[] @default([])
  timeSpentSeconds Int      @default(0)

  // Conversion signals
  conversionIntent   Boolean   @default(false)
  conversionIntentAt DateTime?

  // Source tracking
  source        String  @default("direct") // direct, email, qr, presentation, etc
  campaign      String?
  salespersonId String?

  // Session lifecycle
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime? // Auto-expire after 30 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       DemoEvent[]
  tourProgress DemoTourProgress?
  conversions  DemoConversion[]

  @@index([demoEnvironmentId])
  @@index([sessionToken])
  @@index([status])
  @@index([startedAt])
  @@index([conversionIntent])
}

enum DemoSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  EXPIRED
}

enum DemoExperienceMode {
  ENTRY // Landing screen
  CUSTOMER // Act like customer
  OWNER // Act like owner
  AUTOMATION // Watch WISE² work
  AI // Ask assistant
  MONEY // Revenue view
}

// Demo event log
// Tracks everything that happens in demo
model DemoEvent {
  id            String      @id @default(cuid())
  demoSessionId String      @map("demo_session_id")
  demoSession   DemoSession @relation(fields: [demoSessionId], references: [id], onDelete: Cascade)

  demoEnvironmentId String          @map("demo_environment_id")
  demoEnvironment   DemoEnvironment @relation(fields: [demoEnvironmentId], references: [id], onDelete: Cascade)

  scenarioId String?
  scenario   DemoScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  // Event classification
  eventType String // e.g., "lead.created", "estimate.sent", "payment.simulated"
  category  String // e.g., "customer_action", "system_automation", "ai_response"
  action    String // e.g., "form_submitted", "email_sent", "payment_confirmed"

  // Event data
  dataSnapshot    Json? // Full event details
  affectedRecords String[] @default([]) // IDs of affected records

  // Event result
  success Boolean @default(true)
  message String?

  // Engagement signal
  userInitiated Boolean @default(false) // vs system-triggered

  createdAt DateTime @default(now())

  @@index([demoSessionId])
  @@index([demoEnvironmentId])
  @@index([eventType])
  @@index([createdAt])
}

// Guided tour definitions
model DemoTour {
  id                String          @id @default(cuid())
  demoEnvironmentId String          @map("demo_environment_id")
  demoEnvironment   DemoEnvironment @relation(fields: [demoEnvironmentId], references: [id], onDelete: Cascade)

  // Tour metadata
  key            String // e.g., "LEAD_TO_MONEY"
  name           String
  description    String? @db.Text
  duration       Int     @default(300) // seconds
  targetAudience String  @default("owner") // owner, customer, both

  // Tour sequence
  steps Json // Array of TourStep objects

  // Statistics
  completions       Int    @default(0)
  averageCompletion Float? // seconds

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress DemoTourProgress[]

  @@unique([demoEnvironmentId, key])
  @@index([demoEnvironmentId])
}

// Tour progress tracking
model DemoTourProgress {
  id            String      @id @default(cuid())
  demoSessionId String      @unique @map("demo_session_id")
  demoSession   DemoSession @relation(fields: [demoSessionId], references: [id], onDelete: Cascade)

  tourId String
  tour   DemoTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Progress state
  currentStep    Int        @default(0)
  completedSteps Int[]      @default([])
  status         TourStatus @default(ACTIVE)

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([demoSessionId])
  @@index([tourId])
}

enum TourStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

// Demo-to-live conversion tracking
model DemoConversion {
  id                String          @id @default(cuid())
  demoEnvironmentId String          @map("demo_environment_id")
  demoEnvironment   DemoEnvironment @relation(fields: [demoEnvironmentId], references: [id], onDelete: Cascade)

  demoSessionId String?
  demoSession   DemoSession? @relation(fields: [demoSessionId], references: [id], onDelete: SetNull)

  // Conversion flow
  prospectEmail  String
  prospectName   String?
  conversionStep String  @default("DEMO_VIEWED") // DEMO_VIEWED -> CHECKOUT -> PAYMENT_CONFIRMED -> ACTIVATED

  // Engagement metric
  engagementScore  Float                @default(0.0)
  scenariosViewed  String[]             @default([])
  modesExperienced DemoExperienceMode[] @default([])

  // Stripe integration
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  // Outcome
  status      ConversionStatus @default(PROSPECT)
  convertedAt DateTime?

  // Audit
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demoEnvironmentId])
  @@index([status])
  @@index([convertedAt])
}

enum ConversionStatus {
  PROSPECT // Viewed demo
  INTERESTED // Engaged with demo
  QUALIFIED // Ready to convert
  CHECKOUT // In payment flow
  PAYMENT_CONFIRMED // Payment successful
  ACTIVATED // Demo promoted to live
  LOST // Abandoned
}

// ===== WISE² K10 IMP DEVICE TRACKING =====

// K10Device: Track individual K10 devices
model K10Device {
  id              String  @id @default(cuid())
  deviceId        String  @unique // "k10_001", "k10_002", etc.
  deviceName      String?
  macAddress      String?
  firmwareVersion String? @default("2.0")

  // Status
  lastSeen      DateTime @default(now())
  wifiConnected Boolean  @default(false)
  batteryLevel  Int?
  faceState     Int      @default(0) // 0-12 face expression enum

  // Relationships
  conversations K10Conversation[]
  stateHistory  K10StateHistory[]
  analytics     K10Analytics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([lastSeen])
}

// K10Conversation: Log voice interactions
model K10Conversation {
  id             String    @id @default(cuid())
  conversationId String    @unique @default(cuid())
  deviceId       String
  device         K10Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  // ASR (Speech-to-Text)
  userInput     String?
  asrRecognized String?
  asrConfidence Float?

  // AI Response
  aiResponse String?

  // TTS (Text-to-Speech)
  ttsPlayed  Boolean @default(false)
  durationMs Int?

  // Metadata
  timestamp DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
}

// K10StateHistory: Track device state changes
model K10StateHistory {
  id       String    @id @default(cuid())
  deviceId String
  device   K10Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  deviceState    Int // 0-8: BOOTING, CONNECTING_WIFI, etc.
  faceState      Int // 0-12: face expression enum
  faceExpression String? // "idle", "listening", "thinking", "speaking", etc.
  wifiConnected  Boolean

  timestamp DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
}

// K10Analytics: Collect performance metrics
model K10Analytics {
  id       String    @id @default(cuid())
  deviceId String
  device   K10Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  metricName  String // "listening_duration", "response_latency", "tts_quality", etc.
  metricValue Float
  unit        String? // "ms", "seconds", "%", "words/min", etc.

  timestamp DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
}

// ===== WISE² TRADING PLATFORM =====

// TradingAccount: Per-user trading account configuration
model TradingAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation("tradingAccount", fields: [userId], references: [id], onDelete: Cascade)
  
  // Account settings
  accountName       String?
  accountType       String   @default("DEMO") // DEMO, PAPER, SHADOW, LIVE
  riskPerTrade      Float    @default(1.0) // Risk as % of equity
  maxDailyLoss      Float    @default(500.0)
  maxConsecutiveLosses Int   @default(3)
  maxOpenPositions  Int      @default(5)
  maxCorrelation    Float    @default(0.7)
  
  // Status
  isActive          Boolean  @default(true)
  paperEquity       Float    @default(10000.0)
  realEquity        Float?
  
  // Relationships
  watchlists        Watchlist[]
  positions         Position[]
  trades            Trade[]
  strategies        Strategy[]
  backtestRuns      BacktestRun[]
  riskPolicies      RiskPolicy[]
  journalEntries    JournalEntry[]
  alerts            Alert[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([accountType])
}

// User trading account relation

// Watchlist: Tracked symbols
model Watchlist {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  name              String
  symbol            String
  
  // Latest snapshot
  price             Float?
  bid               Float?
  ask               Float?
  volume            Float?
  volatility        Float?
  
  // Session data (cached)
  asiaHigh          Float?
  asiaLow           Float?
  asiaMidpoint      Float?
  londonHigh        Float?
  londonLow         Float?
  currentRegime     String? // BULLISH, BEARISH, NEUTRAL, RANGING, TRENDING
  
  // Fibonacci levels (cached)
  fib0              Float?
  fib236            Float?
  fib382            Float?
  fib50             Float?
  fib618            Float?
  fib100            Float?
  fib162            Float?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([accountId, symbol])
  @@index([accountId])
  @@index([symbol])
}

// MarketRegime: Classify current market state
model MarketRegime {
  id                String   @id @default(cuid())
  symbol            String
  timeframe         String   @default("4H")
  
  // Regime classification
  regime            String   // TRENDING_UP, TRENDING_DOWN, RANGING, VOLATILE, EXPANSION, COMPRESSION
  confidence        Float    // 0-1 probability
  
  // Supporting metrics
  rsiValue          Float?
  rsiTrend          String?  // RISING, FALLING, NEUTRAL
  volatilityLevel   String?  // LOW, MODERATE, HIGH, EXTREME
  lastHigher        Float?
  lastLower         Float?
  
  detectedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([symbol])
  @@index([timeframe])
  @@index([detectedAt])
}

// Setup: Trade setup detection log
model Setup {
  id                String   @id @default(cuid())
  symbol            String
  
  // Setup identification
  setupType         String   // LIQUIDITY_SWEEP_BULLISH, LIQUIDITY_SWEEP_BEARISH, RANGE_BREAKOUT, etc.
  direction         String   // LONG, SHORT
  confidence        Float    // 0-1 setup score
  
  // Structural data
  impulseHigh       Float?
  impulseLow        Float?
  impulseStart      DateTime?
  impulseEnd        DateTime?
  
  // Fibonacci zone
  entryZone         String   // "0.382-0.618", "0.236-0.382", etc.
  entryZoneStart    Float?
  entryZoneEnd      Float?
  
  // Liquidity
  liquidityLevel    Float?
  sweepMagnitude    Float?
  sweepDuration     Int?     // seconds
  
  // RSI state
  rsiValue          Float?
  rsiDivergence     String?  // BULLISH, BEARISH, NONE
  
  // Market regime
  regime            String?
  bias4H            String?  // BULLISH, BEARISH, NEUTRAL
  
  // Status
  isValid           Boolean  @default(true) // Invalidated if price breaks structure
  wasTraded         Boolean  @default(false) // Did we enter this setup?
  
  detectedAt        DateTime @default(now())
  invalidatedAt     DateTime?
  
  @@index([symbol])
  @@index([setupType])
  @@index([direction])
  @@index([confidence])
  @@index([detectedAt])
}

// Signal: Active trading signal
model Signal {
  id                String   @id @default(cuid())
  setupId           String?
  symbol            String
  
  // Signal definition
  signalType        String   // ENTRY, STOP_HIT, TARGET_HIT, INVALIDATION
  direction         String   // LONG, SHORT
  confidence        Float    // 0-1
  
  // Entry zone
  suggestedEntry    Float
  entryRangeStart   Float?
  entryRangeEnd     Float?
  
  // Risk/Reward
  suggestedStop     Float
  suggestedTarget1  Float
  suggestedTarget2  Float?
  suggestedTarget3  Float?
  
  riskRewardRatio   Float?
  expectedRiskRewInK Float? // Expected R multiple
  
  // Metadata
  explanation       String?  // Why this signal?
  sessionContext    String?  // ASIA, LONDON, NEWYORK
  
  // Status
  status            String   @default("ACTIVE") // ACTIVE, ACCEPTED, REJECTED, EXPIRED, FILLED
  expiresAt         DateTime?
  
  createdAt         DateTime @default(now())
  filledAt          DateTime?
  
  @@index([symbol])
  @@index([direction])
  @@index([status])
  @@index([confidence])
  @@index([createdAt])
}

// Position: Active or closed trade position
model Position {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  symbol            String
  direction         String   // LONG, SHORT
  
  // Entry
  entryPrice        Float
  entryTime         DateTime @default(now())
  quantity          Float
  
  // Stop & Targets
  stopPrice         Float
  target1           Float?
  target2           Float?
  target3           Float?
  
  // Risk management
  initialRisk       Float    // Dollars at risk
  riskPercentage    Float    // % of account equity
  
  // Current state
  currentPrice      Float?
  currentPnL        Float?   // Unrealized P&L
  currentPnLPercent Float?
  
  // Closure
  exitPrice         Float?
  exitTime          DateTime?
  realizedPnL       Float?
  realizedR         Float?   // Realized R multiple
  
  // Metadata
  setupType         String?
  sessionContext    String?
  notes             String?
  
  status            String   @default("OPEN") // OPEN, CLOSED, CANCELLED
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountId])
  @@index([symbol])
  @@index([direction])
  @@index([status])
  @@index([entryTime])
}

// Trade: Historical trade log (same as closed Position, but immutable)
model Trade {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  symbol            String
  direction         String
  entryPrice        Float
  exitPrice         Float
  quantity          Float
  
  entryTime         DateTime
  exitTime          DateTime
  duration          Int      // minutes
  
  pnl               Float
  pnlPercent        Float
  rMultiple         Float?
  
  setupType         String?
  sessionContext    String?
  
  createdAt         DateTime @default(now())
  
  @@index([accountId])
  @@index([symbol])
  @@index([direction])
  @@index([exitTime])
}

// Strategy: Trading strategy definition
model Strategy {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  name              String
  description       String?
  version           Int      @default(1)
  
  // Strategy parameters
  rsiPeriod         Int      @default(14)
  rsiOverbought     Int      @default(70)
  rsiOversold       Int      @default(30)
  
  atrPeriod         Int      @default(14)
  atrMultiplier     Float    @default(1.5)
  
  fibonacciLevels   String   @default("0,0.236,0.382,0.50,0.618,1.0,1.618")
  
  entryConfidence   Float    @default(0.65) // Minimum confidence to trade
  sweepThreshold    Float    @default(1.2)  // ATR multiplier for sweep detection
  
  // Session filtering
  enableAsia        Boolean  @default(true)
  enableLondon      Boolean  @default(true)
  enableNewYork     Boolean  @default(true)
  
  // Risk settings
  riskPerTrade      Float    @default(1.0)
  maxPositionSize   Float?
  
  // Status
  isActive          Boolean  @default(true)
  isBacktested      Boolean  @default(false)
  
  backtestRuns      BacktestRun[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountId])
  @@index([isActive])
}

// BacktestRun: Historical backtest result
model BacktestRun {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  strategyId        String
  strategy          Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  
  // Backtest window
  startDate         DateTime
  endDate           DateTime
  dataType          String   @default("HISTORICAL") // HISTORICAL, WALK_FORWARD, MONTE_CARLO
  
  // Results
  totalTrades       Int      @default(0)
  winningTrades     Int      @default(0)
  losingTrades      Int      @default(0)
  winRate           Float?   // percentage
  profitFactor      Float?   // gross profit / gross loss
  expectancy        Float?   // avg win * win% - avg loss * loss%
  
  totalPnL          Float    @default(0.0)
  maxDrawdown       Float?
  sharpeRatio       Float?
  sortino           Float?
  
  avgWin            Float?
  avgLoss           Float?
  avgR              Float?
  
  maxWinningStreak  Int?
  maxLosingStreak   Int?
  
  // Additional metrics
  notes             String?
  parametersUsed    String?  // JSON string of params
  
  createdAt         DateTime @default(now())
  
  @@index([accountId])
  @@index([strategyId])
  @@index([dataType])
  @@index([winRate])
  @@index([createdAt])
}

// RiskPolicy: Account-level risk rules
model RiskPolicy {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // Daily limits
  maxDailyLoss      Float
  maxConsecutiveLosses Int
  maxOpenPositions  Int
  maxCorrelation    Float    // Max corr between open positions
  
  // Per-trade limits
  maxRiskPerTrade   Float
  minRiskReward     Float    @default(1.0)
  
  // Status
  isActive          Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountId])
}

// RiskEvent: Log of risk rule violations
model RiskEvent {
  id                String   @id @default(cuid())
  accountId         String
  
  eventType         String   // DAILY_LOSS_LIMIT, CONSECUTIVE_LOSSES, MAX_POSITIONS, etc.
  severity          String   @default("WARNING") // WARNING, ALERT, SHUTDOWN
  
  message           String
  metadata          String?  // JSON with context
  
  blockedTrade      Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  
  @@index([accountId])
  @@index([eventType])
  @@index([createdAt])
}

// JournalEntry: Trade review & reflection
model JournalEntry {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // Trade reference
  symbol            String
  tradeDate         DateTime
  
  // Setup details
  setupType         String?
  setupQuality      String?  // A_TIER, B_TIER, C_TIER
  priceAction       String?
  
  // Outcome
  result            String   // WIN, LOSS, BREAKEVEN
  pnl               Float?
  rMultiple         Float?
  
  // Reflection
  whatWentWell      String?
  whatWentWrong     String?
  lessonsLearned    String?
  nextTime          String?
  
  // Emotions
  emotionalState    String?  // CALM, ANXIOUS, OVERCONFIDENT, FRUSTRATED
  disciplineRating  Int?     // 1-10
  
  // Tags
  tags              String?  // comma-separated
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountId])
  @@index([tradeDate])
  @@index([result])
  @@index([setupType])
}

// Alert: User notifications
model Alert {
  id                String   @id @default(cuid())
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  alertType         String   // SIGNAL, RISK, PRICE, SETUP, etc.
  title             String
  message           String
  
  symbol            String?
  priority          String   @default("INFO") // INFO, WARNING, CRITICAL
  
  isRead            Boolean  @default(false)
  actionUrl         String?  // Link to related data
  
  createdAt         DateTime @default(now())
  readAt            DateTime?
  
  @@index([accountId])
  @@index([alertType])
  @@index([isRead])
  @@index([createdAt])
}

// PriceSnapshot: Historical price data for backtesting
model PriceSnapshot {
  id                String   @id @default(cuid())
  symbol            String
  timeframe         String   @default("1H")
  
  openTime          DateTime
  open              Float
  high              Float
  low               Float
  close             Float
  volume            Float?
  
  // Technical indicators (pre-calculated for performance)
  rsi               Float?
  atr               Float?
  
  createdAt         DateTime @default(now())
  
  @@unique([symbol, timeframe, openTime])
  @@index([symbol])
  @@index([timeframe])
  @@index([openTime])
}

// ===== WISE² FIELD TECH (Android) =====
// Net-new module (see docs/ANDROID_IMPLEMENTATION_AUDIT.md) — no equipment/reading/report
// model existed anywhere in this schema prior to this build. Deliberately not FK'd to the
// CRM `Customer` model above: field-tech jobs come from dispatch/intake, not the sales CRM,
// and coupling them risks breaking either flow under time pressure. Revisit if/when the two
// systems need to reconcile the same customer record.

enum FieldTechJobStatus {
  SCHEDULED
  EN_ROUTE
  ARRIVED
  DIAGNOSING
  REPAIRING
  WAITING
  COMPLETE
}

enum FieldTechJobPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum FieldTechReportStatus {
  DRAFT
  FINALIZED
  SENT
}

model FieldTechJob {
  id              String               @id @default(cuid())
  technicianId    String
  customerName    String
  customerPhone   String
  address         String
  appointmentAt   DateTime
  complaint       String               @db.Text
  equipmentId     String?
  equipment       FieldTechEquipment?  @relation(fields: [equipmentId], references: [id])
  status          FieldTechJobStatus   @default(SCHEDULED)
  priority        FieldTechJobPriority @default(NORMAL)
  notes           String               @default("") @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  readings        FieldTechReading[]
  serviceHistory  FieldTechServiceHistory[]
  report          FieldTechReport?

  @@index([technicianId])
  @@index([status])
  @@index([appointmentAt])
}

model FieldTechEquipment {
  id                     String    @id @default(cuid())
  customerName           String
  manufacturer           String
  equipmentType          String
  model                  String
  serial                 String
  refrigerant            String
  voltage                String
  phase                  String
  tonnage                Float?
  installationDate       DateTime?
  location               String
  filterSize             String?
  technicianNotes        String    @default("") @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  jobs                   FieldTechJob[]
  serviceHistory         FieldTechServiceHistory[]

  @@index([serial])
}

model FieldTechServiceHistory {
  id             String             @id @default(cuid())
  equipmentId    String
  equipment      FieldTechEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  jobId          String
  job            FieldTechJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date           DateTime
  summary        String             @db.Text
  technicianName String
  createdAt      DateTime           @default(now())

  @@index([equipmentId])
}

model FieldTechReading {
  id                String   @id @default(cuid())
  jobId             String
  job               FieldTechJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceDeviceName  String
  capturedAt        DateTime

  lowSidePsig       Float?
  highSidePsig      Float?
  suctionSaturationF Float?
  liquidSaturationF Float?
  suctionLineTempF  Float?
  liquidLineTempF   Float?
  dischargeTempF    Float?
  outdoorAmbientF   Float?

  voltageL1         Float?
  voltageL2         Float?
  voltageL3         Float?
  currentL1         Float?
  currentL2         Float?
  currentL3         Float?
  frequencyHz       Float?
  capacitanceMfd    Float?
  resistanceOhms    Float?
  continuityOk      Boolean?

  returnTempF       Float?
  supplyTempF       Float?
  staticPressureInWc Float?

  createdAt         DateTime @default(now())

  @@index([jobId])
}

model FieldTechReport {
  jobId               String                 @id
  job                 FieldTechJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSummary          String                 @default("") @db.Text
  systemInfo          String                 @default("") @db.Text
  customerComplaint   String                 @default("") @db.Text
  diagnosis           String                 @default("") @db.Text
  workPerformed       String[]               @default([])
  materials           Json                   @default("[]")
  recommendations     String                 @default("") @db.Text
  technicianNotes     String                 @default("") @db.Text
  customerApprovalName String?
  status              FieldTechReportStatus  @default(DRAFT)
  updatedAt           DateTime               @updatedAt
}

model FieldTechRelease {
  id           String   @id @default(cuid())
  versionCode  Int      @unique
  versionName  String
  apkUrl       String
  sha256       String
  required     Boolean  @default(false)
  releaseNotes String   @default("") @db.Text
  publishedAt  DateTime @default(now())

  @@index([versionCode])
}

