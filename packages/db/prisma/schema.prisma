model FamilyMember {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  displayName      String             @map("display_name")
  meshNodeId       String?            @map("mesh_node_id")
  status           FamilySafetyStatus @default(UNKNOWN)
