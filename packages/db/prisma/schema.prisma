  riskPolicy      Json? @map("risk_policy")

  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  knowledgeItems DigitalTwinKnowledgeItem[]
  consents       DigitalTwinConsent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("DigitalTwin")
}

model DigitalTwinKnowledgeItem {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  digitalTwinId String      @map("digital_twin_id")
  digitalTwin   DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)

  sourceType String    @map("source_type")
  sourceName String    @map("source_name")
  status     String
  version    String?
  approved   Boolean   @default(false)
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
