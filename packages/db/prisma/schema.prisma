// ============================================================================
// WISE² REVENUE OS
// ----------------------------------------------------------------------------
// Tenant-scoped revenue pipeline: CAMPAIGN → LEAD → CONVERSATION → BOOKING →
// ESTIMATE → SOLD JOB → REVENUE → REVIEW → MEMBERSHIP → REACTIVATION.
//
// Vertical neutrality: core models carry a free-form `serviceType` string so
// the same pipeline serves plumbing/electrical/roofing tenants. HVAC-specific
// classification is namespaced (see HvacServiceCategory) and always nullable.
//
// Identity seam: `TenantMembership.userId` references the TypeORM auth user
// (packages/api/src/auth/user.entity.ts), which lives in a different ORM than
// this schema. It is intentionally an unconstrained String — no Prisma
// relation — and must only ever be populated from an authenticated session.
// ============================================================================

model Tenant {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  vertical String      @default("hvac")
  timezone String      @default("America/New_York")
  state    TenantState @default(PAYMENT_PENDING)

  // Multi-tenancy demo mode flag. When true, no external side effects.
  demoMode Boolean @default(false)

  // Billing reference
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Phase 16 feature gate. When false, no Revenue OS automation may execute.
  revenueOsEnabled Boolean @default(false)

  // Contractor OS module flags, e.g. ["crm", "jobs", "team_chat", "storm"].
  // Empty array means "use the platform default set for this vertical."
  enabledModules String[] @default([])

  // Tenant-approved copy the AI must use verbatim rather than improvising.
  safetyScript String? @db.Text

  // Discord workspace integration
  discordGuildId  String? @unique
  discordBotToken String? // Should be encrypted in production

  // Onboarding progress tracking
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       TenantMembership[]
  customers         RevenueCustomer[]
  leads             Lead[]
  conversations     Conversation[]
  serviceJobs       ServiceJob[]
  estimates         Estimate[]
  campaigns         Campaign[]
  agents            AgentConfig[]
  automationRuns    AutomationRun[]
  webhookEvents     WebhookEvent[]
  consentRecords    ConsentRecord[]
  safetyEvents      SafetyEvent[]
  provisioning      ProvisioningRun?
  verticalTemplates VerticalTemplate[]
  approvals         Approval[]
  workflows         WorkflowDefinition[]
  followUps         FollowUp[]
  contracts         Contract[]
  auditLogs         AuditLog[]
  digitalTwins      DigitalTwin[]
  twinKnowledge     DigitalTwinKnowledgeItem[]
  twinConsents      DigitalTwinConsent[]

  // WISE Defense Safety Radar + Comms Grid
  wiseDefenseMemberships WiseDefenseMembership[]
  incidents              Incident[]
  watchZones             WatchZone[]
  meshNodes              MeshNode[]
  radioDevices           RadioDevice[]
  radioOperators         RadioOperator[]
  radioChannels          RadioChannel[]
  repeaters              Repeater[]
  sdrDevices             SDRDevice[]
  alerts                 SafetyAlert[]
  familyMembers          FamilyMember[]

  // WISE² LIVE - Demo environment
  demoEnvironment DemoEnvironment?

  @@index([slug])
  @@index([state])
  @@index([stripeCustomerId])
}

enum TenantRole {
  OWNER
  ADMIN
  DISPATCHER
  TECHNICIAN
  VIEWER
}

enum WiseDefenseRole {
  OWNER
  ADMIN
  OPERATOR
  INSTRUCTOR
  FAMILY
  VIEWER
  CUSTOMER
}

enum ThreatLevel {
  LOW
  ELEVATED
  HIGH
  CRITICAL
}

enum VerificationStatus {
  UNVERIFIED
  DEVELOPING
  CORROBORATED
  OFFICIAL
  CLEARED
}

enum CommunicationState {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}

enum FamilySafetyStatus {
  SAFE
  CHECK_IN_REQUESTED
  UNKNOWN
  NEEDS_HELP
}

enum TenantState {
  PAYMENT_PENDING
  PROVISIONING
  ONBOARDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum DigitalTwinStatus {
  DRAFT
  ONBOARDING
  TRAINING
  TESTING
  AWAITING_APPROVAL
  ACTIVE
  PAUSED
  REVOKED
  ARCHIVED
}

enum DigitalTwinAutonomyLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum DigitalTwinConsentType {
  VOICE_CLONING
  VIDEO_LIKENESS
  AVATAR_CREATION
  SYNTHETIC_SPEECH
  PUBLIC_CONTENT
  SALES_COMMUNICATION
  CUSTOMER_COMMUNICATION
}

// Authoritative tenant membership. TenantGuard resolves tenant context from
// this table using the authenticated user id — never from a client-supplied
// tenant_id.
model TenantMembership {
  id       String     @id @default(cuid())
  tenantId String     @map("tenant_id")
  userId   String // TypeORM auth user id — see identity seam note above.
  role     TenantRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// Per-vertical estimate/service-category template for Contractor OS.
// Global templates (tenantId null) ship with the platform per vertical
// ("hvac", "roofing", "pressure_washing", ...); a tenant may clone one into
// its own tenantId-scoped copy to customize categories or line items.
model VerticalTemplate {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  vertical String
  name     String

  // Free-text category keys a Lead.serviceCategory may reference for this
  // vertical, e.g. ["inspection", "roof_repair", "roof_replacement"].
  categories String[] @default([])

  // Estimate line-item starting points: [{ name, unit, defaultPrice }, ...].
  lineItems Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vertical, name])
  @@index([vertical])
}

// ============================================================================
// WISE DEFENSE — SAFETY RADAR + COMMS GRID
// Every record below is tenant scoped. Exact private locations are kept out of
// public-facing fields; clients must request redacted representations.
// ============================================================================
model WiseDefenseMembership {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  userId    String          @map("user_id")
  role      WiseDefenseRole @default(VIEWER)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([userId])
}

model Incident {
  id                  String             @id @default(cuid())
  tenantId            String             @map("tenant_id")
  provider            String
  providerIncidentId  String?            @map("provider_incident_id")
  incidentType        String             @map("incident_type")
  category            String
  headline            String
  description         String?            @db.Text
  latitude            Float?
  longitude           Float?
  approximateLocation String?            @map("approximate_location")
  city                String?
  state               String?
  postalCode          String?            @map("postal_code")
  sourceTimestamp     DateTime?          @map("source_timestamp")
  receivedTimestamp   DateTime           @default(now()) @map("received_timestamp")
  status              String             @default("OPEN")
  threatLevel         ThreatLevel        @default(LOW) @map("threat_level")
  confidence          Int                @default(0)
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")
  sourceUrl           String?            @map("source_url")
  audioUrl            String?            @map("audio_url")
  transcript          String?            @db.Text
  aiSummary           String?            @map("ai_summary") @db.Text
  sourceMetadata      Json?              @map("source_metadata")
  isPublic            Boolean            @default(false) @map("is_public")
  isSensitive         Boolean            @default(false) @map("is_sensitive")
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, provider, providerIncidentId])
  @@index([tenantId, threatLevel, receivedTimestamp])
  @@index([tenantId, category])
