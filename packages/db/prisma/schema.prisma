  brandProfile    Json? @map("brand_profile")
  writingProfile  Json? @map("writing_profile")
  voiceProfile    Json? @map("voice_profile")
  avatarProfile   Json? @map("avatar_profile")
  salesProfile    Json? @map("sales_profile")
  supportProfile  Json? @map("support_profile")
  contentProfile  Json? @map("content_profile")
