# WISE² PLATFORM CANDIDATE
# Full platform build: Health, Auth, Billing, Prospects, Customers, Sound Labs, Gallery, Prisma
# Based on packages/api/Dockerfile with explicit Prisma generation

FROM node:20-slim AS builder

WORKDIR /app

# Install build dependencies needed for native modules
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages ./packages

# Install pnpm and dependencies for entire monorepo
RUN npm install -g pnpm && pnpm install --frozen-lockfile --recursive

# Generate Prisma client from canonical schema
WORKDIR /app/packages/db
RUN pnpm exec prisma generate

# Build the full API
WORKDIR /app/packages/api
RUN rm -f tsconfig.tsbuildinfo
RUN pnpm run build

# Verify JavaScript files were generated
RUN if [ ! -f dist/main.js ]; then \
      echo "ERROR: Build failed! No main.js generated."; \
      ls -la dist/ || echo "dist/ directory not found"; \
      exit 1; \
    fi

# Verify activated modules exist in dist
RUN for mod in v1/billing v1/prospects v1/customers v1/gallery v1/sound-labs prisma; do \
      if [ ! -d "dist/$mod" ]; then \
        echo "ERROR: Missing module dist/$mod"; \
        exit 1; \
      fi; \
    done && echo "All platform modules verified in dist/"

# Runtime image
FROM node:20-slim

WORKDIR /app

# Install runtime dependencies (curl for health checks, pnpm for symlinks)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* && npm install -g pnpm

# Copy entire monorepo structure (preserves pnpm symlinks)
COPY --from=builder /app /app

# Recreate pnpm symlinks in runtime
RUN pnpm install --offline --frozen-lockfile --recursive 2>/dev/null || true

# Gallery upload directory
RUN mkdir -p /app/uploads/gallery

WORKDIR /app/packages/api

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/api/health || exit 1

CMD ["node", "dist/main"]
