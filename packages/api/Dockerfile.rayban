FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci --production

# Copy source
COPY packages/api/src/rayban ./src/rayban
COPY packages/api/tsconfig.json .

# Build Ray-Ban service only
RUN npm run build -- --include rayban

# Expose port
EXPOSE 3040

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3040/rayban/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start service
CMD ["node", "dist/rayban/main.js"]
