# WISE² Production Environment Configuration
# DO NOT COMMIT REAL VALUES - This is a template only
# Copy to .env.production and fill with actual credentials

# ============================================================================
# CORE APPLICATION
# ============================================================================
NODE_ENV=production
PORT=3000
API_PORT=3001
APP_URL=https://wise2.net
API_BASE_URL=https://api.wise2.net
NEXT_PUBLIC_API_URL=https://api.wise2.net

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://wise2:SECURE_PASSWORD@postgres:5432/wise2_prod
DATABASE_PASSWORD=SECURE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wise2_prod
DB_USER=wise2

# ============================================================================
# REDIS (Cache & Queue)
# ============================================================================
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# STRIPE (Payment Processing)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_STARTER_PRICE_ID=price_1234567890
STRIPE_PRO_PRICE_ID=price_0987654321

# ============================================================================
# EMAIL (SendGrid)
# ============================================================================
SENDGRID_API_KEY=SG.YOUR_API_KEY
SENDGRID_FROM_EMAIL=noreply@wise2.net
SENDGRID_FROM_NAME=WISE²

# ============================================================================
# AUTHENTICATION & OAUTH
# ============================================================================
JWT_SECRET=LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRY=7d
NEXTAUTH_SECRET=LONG_RANDOM_SECRET_FOR_NEXTAUTH
NEXTAUTH_URL=https://wise2.net

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ============================================================================
# GOOGLE CALENDAR (Consulting Integration)
# ============================================================================
GOOGLE_CALENDAR_CLIENT_ID=YOUR_CALENDAR_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_CALENDAR_CLIENT_SECRET

# ============================================================================
# DISCORD (Notifications)
# ============================================================================
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ============================================================================
# AWS (Storage)
# ============================================================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=wise2-prod-bucket

# ============================================================================
# MONITORING
# ============================================================================
LOG_LEVEL=info
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=SECURE_GRAFANA_PASSWORD

# ============================================================================
# DEPLOYMENT
# ============================================================================
DEPLOYMENT_ENVIRONMENT=production
TRIAL_DAYS=14

# ============================================================================
# AI PROVIDERS
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY

# ============================================================================
# CORS & SECURITY
# ============================================================================
CORS_ORIGIN=https://wise2.net,https://www.wise2.net
CORS_CREDENTIALS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
