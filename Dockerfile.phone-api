# WISE² Phone API Service Dockerfile
# Includes phone service, STT/TTS, and background workers
# Runs on existing infrastructure (shared database, Redis)

FROM node:18-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source
COPY apps/api ./apps/api
COPY packages ./packages
COPY tsconfig*.json ./

# Build
RUN npm run build --workspace=@wise2/api

# Runtime
FROM node:18-alpine

WORKDIR /app

# Install runtime dependencies only
RUN apk add --no-cache \
    curl \
    python3 \
    ffmpeg

# Copy from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

# Create directories for audio files
RUN mkdir -p /tmp/wise2-phone-audio

# Environment
ENV NODE_ENV=production \
    PORT=3001 \
    PHONE_WEBHOOK_URL=http://localhost:3001 \
    WHISPER_URL=http://localhost:8000/v1/audio/transcriptions \
    HERMES_ENDPOINT=http://localhost:11435/v1/chat/completions \
    HERMES_CHAT_MODEL=hermes2-pro \
    HERMES_TIMEOUT_MS=90000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/v1/phone/health || exit 1

# Run
CMD ["node", "dist/apps/api/src/main.js"]
