# Next.js Website Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY apps/website/package.json ./apps/website/
RUN npm install

COPY apps/website ./apps/website
RUN npm run build

# Production image
FROM node:18-alpine

WORKDIR /app

COPY --from=builder /app/apps/website/.next ./apps/website/.next
COPY --from=builder /app/apps/website/package.json ./apps/website/
COPY package*.json ./

RUN cd apps/website && npm install --production

EXPOSE 3001

CMD ["npm", "--prefix", "apps/website", "start", "--", "-p", "3001"]
