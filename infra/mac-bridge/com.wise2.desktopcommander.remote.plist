<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wise2.desktopcommander.remote</string>

    <key>ProgramArguments</key>
    <array>
        <string>node</string>
        <string>/Users/danielwise/wise2/packages/api/bin/desktop-commander-remote.js</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StartInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/danielwise/.wise2/bridge.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/danielwise/.wise2/bridge.error.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>WISE2_BRIDGE_PORT</key>
        <string>9999</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/danielwise</string>
    </dict>

    <!-- Restart policy -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Suppress output for cleaner logs -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>

    <!-- Process group for signal handling -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!-- Enable stderr redirect for debugging -->
    <key>SessionCreate</key>
    <false/>

</dict>
</plist>
