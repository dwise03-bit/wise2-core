<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.wise2.ssh-guard</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/.local/bin/wise2-ssh-guard</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/wise2-ssh-guard.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/wise2-ssh-guard.err.log</string>
</dict></plist>
