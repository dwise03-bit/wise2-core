# WISE² SSH over Tailscale — copy to ~/.ssh/config
# Usage: ssh wise2-vps

Host wise2-vps gpu-nmls gpu-nmls-1
  HostName gpu-nmls-1.tail44396d.ts.net
  User dwise
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host wise2-mac daniels-macbook
  HostName daniels-macbook-pro.tail44396d.ts.net
  User dwise
  IdentityFile ~/.ssh/id_ed25519

Host wise2-iphone
  HostName iphone175.tail44396d.ts.net
  User dwise
  IdentityFile ~/.ssh/id_ed25519

Host wise2-android razr
  HostName motorola-razr-2025-xt2553v.tail44396d.ts.net
  User dwise
  IdentityFile ~/.ssh/id_ed25519

Host wise2-byte byte-mini big-byte
  HostName big-byte.tail44396d.ts.net
  User dwise
