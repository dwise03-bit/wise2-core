#!/bin/bash
################################################################################
# WISE² Backup Monitoring - Cron Configuration
#
# Installation:
#   # Linux (systemd)
#   sudo cp config/cron/wise2-backup-monitoring.cron /etc/cron.d/wise2-backup
#   sudo chmod 644 /etc/cron.d/wise2-backup
#
#   # macOS (LaunchAgent - see launch agent template below)
#   cp config/cron/wise2-backup-monitoring.cron ~/Library/LaunchAgents/
#
#   # Or manual crontab entry
#   crontab -e
#   # (paste the cron lines below)
#
# Verification:
#   sudo systemctl status cron  # Linux
#   log stream --predicate 'process == "cron"'  # macOS
#
# Manual Testing:
#   /opt/wise2-core/scripts/monitor-backups.sh status
#   /opt/wise2-core/scripts/monitor-backups.sh dashboard
#
################################################################################

# ============================================================================
# ENVIRONMENT SETUP
# ============================================================================

# Set PATH for cron environment
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Project root
WISE2_HOME=/opt/wise2-core

# Load environment variables
if [ -f /etc/wise2-backup-env ]; then
    . /etc/wise2-backup-env
fi

# Standard cron environment
SHELL=/bin/bash
MAILTO=ops@wise2.com

# ============================================================================
# HOURLY BACKUP HEALTH CHECKS
# ============================================================================

# Run at top of each hour - quick health check
0 * * * * root /opt/wise2-core/scripts/monitor-backups.sh check-hourly >> /var/log/wise2/backup-monitor.log 2>&1

# ============================================================================
# DAILY CHECKS
# ============================================================================

# 00:30 - Daily backup cleanup (remove old backups per retention policy)
30 0 * * * root /opt/wise2-core/scripts/monitor-backups.sh cleanup >> /var/log/wise2/backup-monitor.log 2>&1

# 06:00 - Daily status check with detailed logging
0 6 * * * root /opt/wise2-core/scripts/monitor-backups.sh status >> /var/log/wise2/backup-status.log 2>&1

# ============================================================================
# WEEKLY REPORTS
# ============================================================================

# Sunday 10:00 UTC - Generate weekly backup report
0 10 * * 0 root /opt/wise2-core/scripts/monitor-backups.sh report > /var/log/wise2/backup-report-weekly.log 2>&1

# ============================================================================
# MONTHLY RESTORE TEST
# ============================================================================

# 1st of month, 02:00 UTC - Test backup restore capability
0 2 1 * * root /opt/wise2-core/scripts/monitor-backups.sh test-restore >> /var/log/wise2/backup-monitor.log 2>&1

# ============================================================================
# NOTES
# ============================================================================
#
# Log Files:
#   /var/log/wise2/backup-monitor.log      - Hourly checks and restore tests
#   /var/log/wise2/backup-status.log       - Daily status checks
#   /var/log/wise2/backup-report-weekly.log - Weekly reports
#
# Alert Destinations:
#   - Email: Set ALERT_EMAIL in /etc/wise2-backup-env
#   - Discord: Set DISCORD_WEBHOOK in /etc/wise2-backup-env
#   - Email to cron MAILTO: ops@wise2.com
#
# Environment File (/etc/wise2-backup-env):
#   export BACKUP_DIR=/backups/wise2
#   export S3_BUCKET_BACKUP=wise2-backups
#   export AWS_REGION=us-east-1
#   export ALERT_EMAIL=ops@wise2.com
#   export DISCORD_WEBHOOK=https://...
#   export DB_HOST=localhost
#   export DB_PORT=5432
#   export DB_NAME=wise2_prod
#   export DB_USER=wise2_prod
#
################################################################################
