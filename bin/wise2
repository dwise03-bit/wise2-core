#!/bin/bash
# wise2 — WISE² Deployment CLI
# Usage: wise2 <command> [args]
#
# Commands:
#   status        Show container status
#   logs [service] Show logs (api, website, db, or all)
#   test          Run tests (if available)
#   deploy        Deploy latest changes
#   rollback      Rollback to previous commit
#   restart       Restart all services
#

set -e

WISE2_DIR="/home/dwise/wise2-core"
COMPOSE_FILE="docker-compose.stable.yml"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_status() {
  echo -e "${GREEN}=== WISE² Service Status ===${NC}"
  cd "$WISE2_DIR"
  docker-compose -f "$COMPOSE_FILE" ps
  echo ""
  echo -e "${GREEN}=== Recent Git Status ===${NC}"
  git log --oneline -3
}

show_logs() {
  local service="${1:-all}"
  cd "$WISE2_DIR"

  case "$service" in
    api)
      docker logs -f wise2-api
      ;;
    website)
      docker logs -f wise2-website
      ;;
    db)
      docker logs -f wise2-db
      ;;
    redis)
      docker logs -f wise2-redis
      ;;
    all)
      echo -e "${YELLOW}Tailing all logs (Ctrl+C to stop):${NC}"
      docker-compose -f "$COMPOSE_FILE" logs -f
      ;;
    *)
      echo "Unknown service: $service"
      echo "Available: api, website, db, redis, all"
      ;;
  esac
}

run_tests() {
  cd "$WISE2_DIR"

  if [ -f "package.json" ]; then
    echo -e "${GREEN}Running npm tests...${NC}"
    npm run test 2>/dev/null || pnpm run test || echo "No test script found"
  else
    echo "No package.json found"
  fi
}

deploy() {
  cd "$WISE2_DIR"

  echo -e "${GREEN}=== WISE² Deployment ===${NC}"
  echo "1. Pulling latest changes..."
  git pull origin main

  echo "2. Checking git status..."
  if [ -z "$(git status --short)" ]; then
    echo "   ✓ Working tree clean"
  else
    echo -e "${RED}   ✗ Uncommitted changes detected!${NC}"
    git status
    read -p "Continue anyway? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Deployment cancelled"
      return 1
    fi
  fi

  echo "3. Restarting containers..."
  docker-compose -f "$COMPOSE_FILE" restart

  echo "4. Verifying services..."
  sleep 5
  curl -s https://wise2.net/ > /dev/null && echo "   ✓ Website responding" || echo "   ✗ Website check failed"
  curl -s http://localhost:3010/api/health > /dev/null && echo "   ✓ API healthy" || echo "   ✗ API check failed"

  echo -e "${GREEN}Deployment complete!${NC}"
}

rollback() {
  cd "$WISE2_DIR"

  echo -e "${YELLOW}=== Rollback ===${NC}"
  echo "Last 3 commits:"
  git log --oneline -3

  read -p "Rollback 1 commit? (y/n) " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    git reset --hard HEAD~1
    echo "Restarting services..."
    docker-compose -f "$COMPOSE_FILE" down
    docker-compose -f "$COMPOSE_FILE" up -d
    echo -e "${GREEN}Rollback complete${NC}"
  else
    echo "Rollback cancelled"
  fi
}

restart_services() {
  cd "$WISE2_DIR"
  echo "Restarting all services..."
  docker-compose -f "$COMPOSE_FILE" restart
  sleep 3
  docker-compose -f "$COMPOSE_FILE" ps
}

# Main command handler
case "${1:-status}" in
  status)
    show_status
    ;;
  logs)
    show_logs "${2:-all}"
    ;;
  test)
    run_tests
    ;;
  deploy)
    deploy
    ;;
  rollback)
    rollback
    ;;
  restart)
    restart_services
    ;;
  *)
    echo "wise2 — WISE² Deployment CLI"
    echo ""
    echo "Usage: wise2 <command> [args]"
    echo ""
    echo "Commands:"
    echo "  status           Show container status"
    echo "  logs [service]   Show logs (api, website, db, redis, or all)"
    echo "  test             Run tests"
    echo "  deploy           Deploy latest changes"
    echo "  rollback         Rollback to previous commit"
    echo "  restart          Restart all services"
    ;;
esac
