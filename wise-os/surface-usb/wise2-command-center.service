[Unit]
Description=WISE² Linux OS Command Center
After=network.target

[Service]
User=wise2-ui
Group=wise2-ui
WorkingDirectory=/opt/wise2/command-center
Environment=WISE2_HOST=127.0.0.1
Environment=WISE2_PORT=3080
Environment=WISE2_DATA_DIR=/var/lib/wise2-ui
StateDirectory=wise2-ui
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
