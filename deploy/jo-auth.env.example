# Copy to deploy/.env.jo-auth (git-ignored) and fill in. No real values belong in this file.

# Public hostnames for nginx and certbot
JOCREDIT_DOMAIN=
AUTH_DOMAIN=

# auth-gateway (required; the container will not start without them)
JWT_SECRET=
AUTH_DB_HOST=
AUTH_DB_PORT=5432
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=

# jo-credit build-time public values (inlined into the client bundle; optional)
NEXT_PUBLIC_API_URL=https://api.wise2.net
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-side jo-credit secrets (STRIPE_SECRET_KEY, DISCORD_*, GOOGLE_*) go in
# deploy/.env.jo-credit, which the compose file loads if present.
