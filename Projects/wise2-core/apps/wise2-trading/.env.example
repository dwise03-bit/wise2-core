# Require this exact shared secret in TradingView webhook JSON as `secret`.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional Discord Incoming Webhook URL. Leave blank to run without Discord delivery.
DISCORD_WEBHOOK_URL=

# Live TradingView CME NQ/MNQ alerts. Does not place orders.
ALLOW_LIVE_SIGNAL_ALERTS=true
NQ_LIVE_PATH=data/nq-live.json

# AI Coach — OpenAI-compatible provider. Use Ollama for local/private inference
# or DeepSeek for hosted coding/content generation. These are server-only.
AI_PROVIDER=ollama
AI_API_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
