{
  "appId": "com.wisedefense.fieldtech",
  "appName": "WISE Field Tech",
  "webDir": "out",
  "server": {
    "url": "https://hvac.wise2.net",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "https://hvac.wise2.net",
      "https://wise2.net",
      "https://*.wise2.net",
      "https://accounts.google.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000
    },
    "App": {
      "scheme": "com.wise2.fieldtech"
    }
  }
}
