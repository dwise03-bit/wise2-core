[Unit]
Description=WISE² Defense RTL-SDR Spectrum Processor
Documentation=https://wise2.net/docs/sdr-processor
After=network-online.target wise2-defense.service
Wants=network-online.target

[Service]
Type=simple
User=wise2
WorkingDirectory=/opt/wise2-defense/app
ExecStart=/usr/bin/python3 /opt/wise2-defense/app/sdr_processor.py \
  --api-url http://localhost:3014 \
  --freq-start 88 \
  --freq-stop 1200 \
  --interval 10

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
MemoryLimit=256M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wise2-sdr

# Security
PrivateTmp=yes
NoNewPrivileges=yes

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="WISE_DEFENSE_API_KEY=YOUR_API_KEY_HERE"

[Install]
WantedBy=multi-user.target
