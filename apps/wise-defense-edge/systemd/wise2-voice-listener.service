[Unit]
Description=WISE² Defense - Always-On Voice Listener
Documentation=man:wise2-voice-listener(8)
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/wise2/apps/wise-defense-edge
Environment="PYTHONUNBUFFERED=1"
Environment="DEVICE_INDEX=2"
Environment="SAMPLE_RATE=16000"

# Start voice listener
ExecStart=/usr/bin/python3 /opt/wise2/apps/wise-defense-edge/app/voice/voice_listener.py

# Restart on failure
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
MemoryMax=256M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wise2-voice-listener

[Install]
WantedBy=multi-user.target
