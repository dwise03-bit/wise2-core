<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WISE² Ultimate Hub</title><style>
:root{color-scheme:dark;font-family:Inter,system-ui,Arial;background:#030b12;color:#e9ffff}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 65% 5%,#073b49 0%,transparent 42%),radial-gradient(ellipse at 0 80%,#08291c,transparent 45%),#030b12;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background-image:linear-gradient(#29f5c10a 1px,transparent 1px),linear-gradient(90deg,#29f5c10a 1px,transparent 1px);background-size:56px 56px;pointer-events:none}.wrap{max-width:1550px;margin:auto;padding:3vw}header{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}.logo{font-weight:950;font-size:clamp(30px,4vw,56px);letter-spacing:-3px}.logo span{color:#78ffad}.badge{padding:12px 18px;border:1px solid #1b735f;border-radius:30px;color:#8affb3;background:#061b1a}h1{font-size:clamp(35px,5.8vw,86px);letter-spacing:-3px;margin:6vh 0 5px;line-height:1.05}h1 em{font-style:normal;color:#77ffac}p{color:#9bbbc3;font-size:clamp(16px,1.5vw,23px)}nav{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0}button,.tile{cursor:pointer;border:1px solid #20635d;color:#e9ffff;background:linear-gradient(140deg,#0b2531,#08151e);border-radius:17px;padding:16px 24px;font-size:18px;transition:.2s}button:hover,.tile:hover,button.active{border-color:#80ffaf;box-shadow:0 0 25px #30e6a32b;transform:translateY(-2px)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:17px}.tile{text-decoration:none;min-height:160px;display:flex;flex-direction:column;justify-content:space-between}.icon{font-size:35px}.tile strong{font-size:23px}.tile small{color:#9dbcc4}section{display:none}section.active{display:block}.footer{margin-top:42px;border-top:1px solid #194a4c;padding-top:20px;color:#77a8ac;display:flex;gap:20px;flex-wrap:wrap}.orb{position:fixed;right:7%;top:22%;height:160px;width:160px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#9affcc,#00ad9b 30%,#053d53 60%,transparent 70%);filter:blur(1px);opacity:.25;animation:float 7s ease-in-out infinite;pointer-events:none}@keyframes float{50%{transform:translateY(-40px) scale(1.15)}}@media(max-width:600px){.wrap{padding:24px}.tile{min-height:125px}h1{margin-top:40px}}
</style></head><body><div class="orb"></div><div class="wrap"><header><div class="logo">⬡ WISE<span>²</span> <small style="font-size:.35em;letter-spacing:2px">LIVING HIVE</small></div><div class="badge">● SURFACE TV HUB • ONLINE</div></header><h1>YOUR SPACE.<br><em>YOUR COMMAND.</em></h1><p>Entertainment, intelligence and operations — one living interface.</p><nav><button class="active" data-mode="tv">▶ ENTERTAINMENT</button><button data-mode="command">⬡ COMMAND CENTER</button><button data-mode="ai">✦ JARVIS AI</button><button data-mode="night">☾ BEDTIME</button></nav>
<section id="tv" class="active"><div class="grid"><a class="tile" href="https://www.youtube.com" target="_blank"><span class="icon">▶</span><strong>YouTube</strong><small>Watch & discover</small></a><a class="tile" href="https://www.netflix.com" target="_blank"><span class="icon">▣</span><strong>Netflix</strong><small>Movies & series</small></a><a class="tile" href="https://www.spotify.com" target="_blank"><span class="icon">♫</span><strong>Spotify</strong><small>Music & podcasts</small></a><a class="tile" href="https://www.twitch.tv" target="_blank"><span class="icon">◉</span><strong>Twitch</strong><small>Live streams</small></a></div></section>
<section id="command"><div class="grid"><a class="tile" href="https://wise2.net/hive" target="_blank"><span class="icon">⬡</span><strong>Living Hive</strong><small>WISE² operations</small></a><a class="tile" href="https://sjs.wise2.net/every-day-trader" target="_blank"><span class="icon">▥</span><strong>Everyday Trader</strong><small>Trading workspace</small></a><a class="tile" href="https://wise2.net" target="_blank"><span class="icon">◈</span><strong>WISE² Network</strong><small>Projects & services</small></a><a class="tile" href="http://localhost:3000" target="_blank"><span class="icon">▤</span><strong>Legacy TV Hub</strong><small>Existing local interface</small></a></div></section>
<section id="ai"><div class="grid"><div class="tile"><span class="icon">✦</span><strong>JARVIS</strong><small>Voice integration pending; no microphone capture enabled</small></div><a class="tile" href="http://localhost:3012" target="_blank"><span class="icon">◎</span><strong>Hermes</strong><small>Local service (API may not show a webpage)</small></a><div class="tile"><span class="icon">🎙</span><strong>It's Morphing Time</strong><small>Wake-word setup pending</small></div></div></section>
<section id="night"><div class="grid"><div class="tile" onclick="document.body.style.filter='brightness(.45)'"><span class="icon">☾</span><strong>Dim screen</strong><small>Tap to dim the interface</small></div><div class="tile" onclick="document.body.style.filter='none'"><span class="icon">☀</span><strong>Restore brightness</strong><small>Restore normal interface</small></div><a class="tile" href="https://music.youtube.com" target="_blank"><span class="icon">♫</span><strong>Sleep music</strong><small>Open YouTube Music</small></a></div></section><div class="footer"><span>⬡ WISE² ULTIMATE HUB</span><span>Surface Linux • TV Mode</span><span id="clock"></span><span>Remote: open this page on your phone over Tailscale</span></div></div><script>
document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{document.querySelectorAll('section').forEach(x=>x.classList.toggle('active',x.id===b.dataset.mode));document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b))});setInterval(()=>document.getElementById('clock').textContent=new Date().toLocaleString(),1000);document.addEventListener('keydown',e=>{if(['1','2','3','4'].includes(e.key))document.querySelectorAll('[data-mode]')[+e.key-1].click()});
</script></body></html>
