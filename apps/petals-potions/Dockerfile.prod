FROM node:18-alpine AS builder

WORKDIR /app

# Copy root and petals-potions workspace
COPY package*.json ./
COPY apps/petals-potions ./apps/petals-potions

# Install dependencies
RUN npm install

# Build frontend
WORKDIR /app/apps/petals-potions/web
RUN npm run build

# Production image
FROM node:18-alpine

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy built application from builder
COPY --from=builder /app/apps/petals-potions/web/.next ./web/.next
COPY --from=builder /app/apps/petals-potions/web/public ./web/public
COPY --from=builder /app/apps/petals-potions/web/package*.json ./web/

# Install production dependencies only
WORKDIR /app/web
RUN npm install --production

EXPOSE 3003

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
