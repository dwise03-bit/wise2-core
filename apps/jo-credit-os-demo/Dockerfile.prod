# Build context is the repository root (pnpm workspace); see Dockerfile.prod.dockerignore.
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@8.15.9 --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts --filter "@wise2/jo-credit-os-demo..."

# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_DASHBOARD_URL
ARG NEXT_PUBLIC_DISCORD_COMMUNITY_LINK
ARG NEXT_PUBLIC_DISCORD_SERVER_INVITE
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID
ARG NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID
ARG NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID
ARG NEXT_PUBLIC_YOUTUBE_API_KEY
ARG NEXT_PUBLIC_YOUTUBE_CHANNEL_ID
ARG NEXT_PUBLIC_YOUTUBE_CHANNEL_URL
ARG NEXT_PUBLIC_YOUTUBE_DEMO_VIDEO_ID
ARG NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_DASHBOARD_URL=$NEXT_PUBLIC_DASHBOARD_URL \
    NEXT_PUBLIC_DISCORD_COMMUNITY_LINK=$NEXT_PUBLIC_DISCORD_COMMUNITY_LINK \
    NEXT_PUBLIC_DISCORD_SERVER_INVITE=$NEXT_PUBLIC_DISCORD_SERVER_INVITE \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=$NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID \
    NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID=$NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID \
    NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=$NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID \
    NEXT_PUBLIC_YOUTUBE_API_KEY=$NEXT_PUBLIC_YOUTUBE_API_KEY \
    NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=$NEXT_PUBLIC_YOUTUBE_CHANNEL_ID \
    NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=$NEXT_PUBLIC_YOUTUBE_CHANNEL_URL \
    NEXT_PUBLIC_YOUTUBE_DEMO_VIDEO_ID=$NEXT_PUBLIC_YOUTUBE_DEMO_VIDEO_ID \
    NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=$NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID \
    SKIP_ENV_VALIDATION=true \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/jo-credit-os-demo
RUN pnpm run build

FROM node:22-alpine
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app

# Next infers the workspace root, so the server lives under apps/jo-credit-os-demo.
COPY --from=builder /app/apps/jo-credit-os-demo/.next/standalone ./
COPY --from=builder /app/apps/jo-credit-os-demo/.next/static ./apps/jo-credit-os-demo/.next/static
COPY --from=builder /app/apps/jo-credit-os-demo/public ./apps/jo-credit-os-demo/public

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["node", "apps/jo-credit-os-demo/server.js"]
