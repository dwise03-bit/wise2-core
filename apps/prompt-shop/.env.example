# Milestone 0 has no required secrets.
# Future provider/API configuration belongs here, never hard-coded in source.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
REPLICATE_API_TOKEN=
# Use owner/model for official models, or supply a version hash below.
REPLICATE_VIDEO_MODEL=
REPLICATE_VIDEO_VERSION=
# Keep this synchronized with the selected model's official price. It enables
# lowest-cost routing and preflight spend limits without hard-coding stale rates.
REPLICATE_VIDEO_COST_PER_SECOND_USD=
FAL_KEY=
FAL_VIDEO_MODEL=
# Set one pricing unit for the exact fal model. Per-second takes precedence when
# duration is relevant; otherwise use the flat output price.
FAL_VIDEO_COST_PER_SECOND_USD=
FAL_VIDEO_FLAT_COST_USD=
# Safe default: no paid provider can be called until purchasing/webhooks have
# credited user accounts and the operator explicitly enables generation.
VIDEO_GENERATION_ENABLED=false
VIDEO_GLOBAL_MAX_JOB_COST_USD=2.00
# Local AUTOMATIC1111-compatible Stable Diffusion endpoint. Running locally
# avoids per-image API fees. In Docker on Linux, host.docker.internal is mapped.
LOCAL_IMAGE_API_URL=http://host.docker.internal:7860
GENERATED_IMAGE_DIR=/app/generated
DATABASE_URL=
AUTH_SECRET=
NODE_ENV=development
PORT=8787
# Hosted Stripe Checkout for W²-free Pro downloads. Price and amount are
# controlled in Stripe; the browser never submits a price identifier.
APP_URL=http://localhost:8787
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
