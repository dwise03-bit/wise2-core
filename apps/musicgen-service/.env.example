# MusicGen Inference Server Configuration

# Server
MUSICGEN_HOST=0.0.0.0
MUSICGEN_PORT=5000
DEBUG=false
GUNICORN_WORKERS=2

# Model Configuration
MUSICGEN_MODEL=facebook/musicgen-large
DEVICE=cuda
USE_FP16=true
HF_HOME=/app/models

# TTS Configuration
TACOTRON2_MODEL=tacotron2
HIFIGAN_MODEL=hifigan
ENABLE_TTS=true

# Generation Defaults
DEFAULT_DURATION=30
MAX_DURATION=120
DEFAULT_TOP_K=250
DEFAULT_TOP_P=0.0
DEFAULT_TEMPERATURE=1.0
BATCH_SIZE=4

# Queue Configuration
MAX_QUEUE_SIZE=100
QUEUE_TIMEOUT=3600

# Audio Output
SAMPLE_RATE=32000
CHANNELS=1

# Streaming
CHUNK_DURATION=0.5
ENABLE_STREAMING=true

# Optional: HuggingFace Token (for private models)
# HUGGINGFACE_TOKEN=your_token_here
