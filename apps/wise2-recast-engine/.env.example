# WISE² CLIP ENGINE × OPENJUTSU RECAST ENGINE — Configuration Template
# Copy to .env (NEVER commit .env or real passwords/API keys)

# Server binding
WISE2_PORT=47231
# Set WISE2_BIND_ALL=1 together with WISE2_ACCESS_PASSWORD (>=12 chars) for iPhone / Tailscale access
WISE2_BIND_ALL=
WISE2_ACCESS_PASSWORD=

# Upload limits & storage
WISE2_MAX_UPLOAD_MB=512
WISE2_DATA_DIR=

# Remote ComfyUI (e.g. WISE2 gpu-nmls-1 Tailscale node, LAN GPU box, or Cloudflare tunnel)
COMFYUI_URL=http://100.66.102.124:8188
COMFY_BASE_URL=http://100.66.102.124:8189

# Free Cloud GPU Tunnel URLs (paste output from deploy/colab or deploy/kaggle notebook)
COLAB_COMFYUI_URL=
KAGGLE_COMFYUI_URL=

# Optional Paid Fallback (RunPod) — DISABLED by default; requires explicit opt-in
WISE2_ALLOW_PAID_BACKENDS=false
RUNPOD_COMFYUI_URL=
