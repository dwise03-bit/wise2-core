# Environment Configuration for Voice Synthesis Service

# Environment
ENVIRONMENT=development
DEBUG=true

# Device (cpu or cuda)
DEVICE=cpu

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4

# Paths
DATA_DIR=data
MODELS_DIR=models
OUTPUT_DIR=output
LOGS_DIR=logs

# Feature Flags
ENABLE_VOICE_CLONING=true
ENABLE_SINGING=true
ENABLE_EMOTION=true
ENABLE_CACHE=true

# Redis Cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Audio Configuration
SAMPLE_RATE=22050
N_FFT=1024
HOP_LENGTH=256
N_MELS=80

# Model Configuration
ENCODER_HIDDEN_DIM=512
DECODER_HIDDEN_DIM=1024
SPEAKER_EMBED_DIM=256

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=1000
