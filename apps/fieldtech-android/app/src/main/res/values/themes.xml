<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WiseFieldTech" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/jet_black</item>
        <item name="android:navigationBarColor">@color/jet_black</item>
        <item name="android:windowBackground">@color/jet_black</item>
    </style>

    <style name="Theme.WiseFieldTech.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jet_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.WiseFieldTech</item>
    </style>
</resources>
