{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsLoader": true,
    "sourceMap": true
  },
  "generateOptions": {
    "spec": true,
    "flat": false
  },
  "monorepoMode": false
}
