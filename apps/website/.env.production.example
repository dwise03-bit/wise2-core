# Copy to .env.production on the deployment host — never commit .env.production
# Application URLs
NEXT_PUBLIC_SITE_URL=https://wise2.net
NEXT_PUBLIC_API_URL=https://api.wise2.net
NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Stripe (public keys only in this file; secrets via platform secret manager)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_xxx
# STRIPE_SECRET_KEY=sk_live_... (server-side only)
# STRIPE_WEBHOOK_SECRET=whsec_... (server-side only)

# Google OAuth (secrets in deployment platform)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wise2.net/api/auth/google/callback

# Discord (secrets in deployment platform)
DISCORD_REDIRECT_URI=https://wise2.net/api/auth/discord/callback
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
NEXT_PUBLIC_DISCORD_SERVER_INVITE=https://discord.gg/wise2
NEXT_PUBLIC_DISCORD_COMMUNITY_LINK=https://discord.gg/wise2

# YouTube (optional)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxx
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@wise2channel
NEXT_PUBLIC_YOUTUBE_DEMO_VIDEO_ID=
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=
# NEXT_PUBLIC_YOUTUBE_API_KEY=

NODE_ENV=production
HERMES_ENDPOINT=http://localhost:11434/v1/chat/completions
