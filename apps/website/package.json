{
  "name": "@wise2/website",
  "version": "0.1.0",
  "description": "WISE² Enterprise public website & landing page",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "SKIP_ENV_VALIDATION=true next build",
