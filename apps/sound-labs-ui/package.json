{
  "name": "@wise2/sound-labs-ui",
  "version": "0.1.0",
  "description": "WISE² Sound Labs Command Center - Cinematic UI for MASCHINE MIKRO MK3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "mobile:sync": "pnpm build && cap sync android",
    "mobile:open": "cap open android",
    "mobile:build": "pnpm mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:install": "pnpm mobile:build && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  }
}
