[Unit]
Description=WISE² Pi Automated Update Timer
Documentation=file:///opt/wise2-edge/scripts/UPDATE_PI_GUIDE.md

[Timer]
# Run daily at 3:00 AM (low-traffic time)
# Format: DOW Year-Month-Day Hour:Minute:Second
OnCalendar=*-*-* 03:00:00

# Run even if system was powered down at scheduled time
Persistent=true

# Randomize start time by up to 5 minutes to avoid thundering herd
RandomizedDelaySec=5min

# Service to run
Unit=wise2-update.service

[Install]
WantedBy=timers.target
