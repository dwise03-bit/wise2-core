# WISE² Backup Configuration File
# Location: /etc/wise2/backup.env
#
# This file contains all configuration for the backup-pi.sh script.
# Keep this file secure (mode 600) as it contains sensitive information.

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL database name
DB_NAME=wise2_prod

# PostgreSQL user
DB_USER=wise2

# PostgreSQL host
DB_HOST=localhost

# PostgreSQL port
DB_PORT=5432

# PostgreSQL password
# WARNING: Store this securely. Consider using .pgpass file instead:
#   ~/.pgpass format: hostname:port:database:username:password
#   chmod 600 ~/.pgpass
DB_PASS=your-secure-postgres-password-here

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup root directory (must be created and writable by wise2 user)
BACKUP_ROOT=/data/wise2/backups

# Retention policies (number of backups to keep)
RETENTION_DAILY=30        # Keep last 30 daily backups
RETENTION_WEEKLY=12       # Keep last 12 weekly backups
RETENTION_MONTHLY=12      # Keep last 12 monthly backups

# ============================================================================
# Notification Configuration
# ============================================================================

# Email notification (requires mail/sendmail configured on Pi)
# Leave empty to disable email notifications
NOTIFY_EMAIL=ops@wise2.dev

# Email should be a valid address to receive backup status reports

# Slack notification
NOTIFY_SLACK=true

# Slack webhook URL (get from your Slack workspace settings)
# Apps > Incoming Webhooks > Create New Webhook
# Leave empty to disable Slack notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# S3 Remote Backup Configuration (Optional)
# ============================================================================

# Enable S3 backups (true/false)
# Requires: aws-cli configured with credentials
S3_ENABLED=false

# S3 bucket name (must exist and be writable)
S3_BUCKET=wise2-backups

# S3 region
S3_REGION=us-east-1

# S3 prefix (backups stored at s3://bucket/prefix/YYYY-MM/*)
S3_PREFIX=wise2-backups

# AWS Configuration (if S3_ENABLED=true):
# 1. Install AWS CLI: sudo apt-get install awscli
# 2. Configure credentials: aws configure
#    - Access Key ID: <your-access-key>
#    - Secret Access Key: <your-secret-key>
#    - Default region: us-east-1
#    - Default output format: json
# 3. Test S3 access: aws s3 ls s3://wise2-backups/
#
# Or use IAM role on EC2 (preferred in cloud):
# 1. Attach IAM role with S3 permissions to EC2 instance
# 2. No need to configure credentials locally

# ============================================================================
# Backup Logging
# ============================================================================

# Log directory (must be created and writable by wise2 user)
LOG_DIR=/var/log/wise2

# Logs are written to: /var/log/wise2/backup-YYYY-MM-DD.log
# Plus: /var/log/wise2/backup.log (aggregated)

# ============================================================================
# Advanced Configuration
# ============================================================================

# Application data directory
APP_DATA_DIR=/data/wise2/app

# Application logs directory (last 30 days are backed up)
APP_LOGS_DIR=/var/log/wise2

# Temporary backup working directory
BACKUP_TEMP=/data/wise2/backups/tmp

# PostgreSQL backup directory (SQL dumps)
POSTGRES_BACKUP_DIR=/data/wise2/backups/postgres

# ============================================================================
# Usage Examples
# ============================================================================

# To use this configuration file:
#
# 1. Copy to system config:
#    sudo cp scripts/backup.env.example /etc/wise2/backup.env
#
# 2. Edit with your values:
#    sudo nano /etc/wise2/backup.env
#
# 3. Secure the file:
#    sudo chmod 600 /etc/wise2/backup.env
#    sudo chown wise2:wise2 /etc/wise2/backup.env
#
# 4. Source in scripts (automatically done in crontab):
#    source /etc/wise2/backup.env
#
# 5. Run backup manually:
#    source /etc/wise2/backup.env
#    /usr/local/bin/wise2-backup full
#
# 6. Run with S3 upload:
#    source /etc/wise2/backup.env
#    /usr/local/bin/wise2-backup full --upload-s3

# ============================================================================
# Security Notes
# ============================================================================

# 1. Database Password:
#    - Never hardcode password in .env file
#    - Use .pgpass file instead (see DB_PASS comment above)
#    - Or use PostgreSQL peer authentication for localhost connections
#
# 2. File Permissions:
#    - Keep this file mode 600 (readable only by owner)
#    - Store in secure location (/etc/wise2/)
#
# 3. AWS Credentials:
#    - Use IAM roles on EC2 instead of hardcoded keys
#    - If using keys, rotate regularly (every 90 days)
#    - Never commit credentials to git
#
# 4. Backup Storage:
#    - Use encrypted storage (AWS S3 with SSE)
#    - Separate backups from primary data
#    - Test restore procedures regularly

# ============================================================================
# Common Patterns
# ============================================================================

# Development Environment (no S3, local backups only):
# DB_NAME=wise2_dev
# S3_ENABLED=false
# RETENTION_DAILY=7
# RETENTION_WEEKLY=0
# RETENTION_MONTHLY=0

# Staging Environment (S3 with weekly cleanup):
# DB_NAME=wise2_staging
# S3_ENABLED=true
# RETENTION_DAILY=14
# RETENTION_WEEKLY=8
# RETENTION_MONTHLY=3

# Production Environment (full retention, S3 enabled):
# DB_NAME=wise2_prod
# S3_ENABLED=true
# RETENTION_DAILY=30
# RETENTION_WEEKLY=12
# RETENTION_MONTHLY=12
