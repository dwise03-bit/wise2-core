# WISE² Health Check Configuration
# Copy this file to .env.health-check and customize for your environment

# Email Configuration
# Email address to send alerts to
ALERT_EMAIL=dwise03@gmail.com

# Email sender address (optional)
MAIL_FROM=pi-health@wise2.net

# API Configuration
# Health endpoint for the API
API_ENDPOINT=http://localhost:3001/health

# Cloud API endpoint (optional, for latency testing)
CLOUD_API=api.wise2.net

# Database Configuration
# Database host and port for connectivity checks
DB_HOST=localhost
DB_PORT=5432

# Optional: Database credentials (for advanced checks)
# DB_USER=wise2
# DB_PASS=your_password
# DB_NAME=wise2

# Webhook Configuration
# Send JSON reports to this webhook endpoint
# Examples:
# - Discord: https://discordapp.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# - Slack: https://hooks.slack.com/services/YOUR/ID
# - Custom: https://monitoring.wise2.net/api/health-check
WEBHOOK_URL=

# Alert Thresholds (customize these as needed)

# Disk usage percentage threshold (alert at this % or higher)
DISK_WARN_PCT=85

# Memory usage percentage threshold (alert at this % or higher)
MEMORY_WARN_PCT=90

# Maximum age of backups in hours (alert if older)
BACKUP_MAX_AGE_HOURS=48

# Days before SSL certificate expiration to alert
CERT_WARN_DAYS=30

# Number of errors in application logs in 1 hour to trigger alert
ERROR_THRESHOLD_HOUR=10

# Logging Configuration

# Log directory for health check reports
LOG_DIR=/path/to/wise2-core/logs

# Keep logs for this many days before cleanup (optional)
LOG_RETENTION_DAYS=30

# Advanced Configuration (optional)

# Enable verbose output in cron jobs (set to true for debugging)
VERBOSE=false

# Slack channel for webhook notifications (if using Slack)
# SLACK_CHANNEL=#ops-alerts

# PagerDuty integration (optional)
# PAGERDUTY_KEY=your_pagerduty_integration_key

# Custom hostname override (default: system hostname)
# CUSTOM_HOSTNAME=wise2-pi-production

# Enable SSL certificate checking (default: true)
CHECK_SSL_CERTS=true

# Enable Docker checks (default: true)
CHECK_DOCKER=true

# Enable database checks (default: true)
CHECK_DATABASE=true

# Enable backup checks (default: true)
CHECK_BACKUPS=true

# Enable log checks (default: true)
CHECK_LOGS=true

# Local backup directory to check
BACKUP_DIR=/path/to/wise2-core/backups

# Docker compose file location (optional, for advanced checks)
DOCKER_COMPOSE_FILE=/path/to/wise2-core/docker-compose.prod.yml
