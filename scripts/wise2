#!/usr/bin/env bash
# =============================================================================
# wise2 — WISE² control CLI
# Safe, allowlisted subcommands. No eval. No browser-to-shell. Read-mostly.
# Install: symlink /usr/local/bin/wise2 -> /opt/wise2/scripts/wise2 (needs sudo)
# =============================================================================
set -euo pipefail

WISE2_ROOT="${WISE2_ROOT:-/opt/wise2}"
SCRIPTS="$WISE2_ROOT/scripts"
# shellcheck source=/opt/wise2/scripts/lib/common.sh
source "$SCRIPTS/lib/common.sh"

WISE2_CLI_VERSION="0.1.0"

banner() {
  printf '%s' "$C_GREEN"
  cat <<'EOF'
 __      __ _____  _____ ______ ²
 \ \    / /|_   _|/ ____|  ____|
  \ \  / /   | | | (___ | |__
   \ \/ /    | |  \___ \|  __|
    \  /    _| |_ ____) | |____
     \/    |_____|_____/|______|
EOF
  printf '%s  WISE² Linux control CLI  v%s%s\n' "$C_SILVER" "$WISE2_CLI_VERSION" "$C_RESET"
}

usage() {
  banner
  cat <<EOF

${C_BOLD}Usage:${C_RESET} wise2 <command>

  ${C_CYAN}status${C_RESET}     One-screen WISE² overview
  ${C_CYAN}doctor${C_RESET}     PASS/WARN/FAIL diagnostic
  ${C_CYAN}system${C_RESET}     Host / CPU / RAM / disk / kernel
  ${C_CYAN}network${C_RESET}    Interfaces, routes, listening ports
  ${C_CYAN}devices${C_RESET}    Tailnet device inventory
  ${C_CYAN}ssh${C_RESET}        SSH service + remote-access info
  ${C_CYAN}tailscale${C_RESET}  Tailscale mesh status
  ${C_CYAN}claude${C_RESET}     Claude Code agent status
  ${C_CYAN}codex${C_RESET}      OpenAI Codex agent status
  ${C_CYAN}hermes${C_RESET}     Hermes second-brain status
  ${C_CYAN}shannon${C_RESET}    Shannon security engine status (no scan)
  ${C_CYAN}pentest${C_RESET}    Launch guarded authorized engagement (prompts)
  ${C_CYAN}command${C_RESET}    Command Center status
  ${C_CYAN}projects${C_RESET}   List WISE² projects
  ${C_CYAN}support${C_RESET}    Remote-support status
  ${C_CYAN}backup${C_RESET}     Snapshot config + context
  ${C_CYAN}update${C_RESET}     Check component versions (no changes)
  ${C_CYAN}logs${C_RESET}       Show recent WISE² logs
  ${C_CYAN}version${C_RESET}    Versions of WISE² components
  ${C_CYAN}help${C_RESET}       This help
EOF
}

cmd_system() {
  wise2_hr
  printf '%sHost:%s   %s\n' "$C_BOLD" "$C_RESET" "$(hostnamectl --static 2>/dev/null)"
  printf '%sOS:%s     %s\n' "$C_BOLD" "$C_RESET" "$(. /etc/os-release; echo "$PRETTY_NAME")"
  printf '%sKernel:%s %s\n' "$C_BOLD" "$C_RESET" "$(uname -r)"
  printf '%sCPU:%s    %s\n' "$C_BOLD" "$C_RESET" "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
  printf '%sRAM:%s    %s\n' "$C_BOLD" "$C_RESET" "$(free -h | awk '/^Mem:/{print $3" used / "$2" total ("$7" avail)"}')"
  printf '%sDisk:%s   %s\n' "$C_BOLD" "$C_RESET" "$(df -h / | awk 'NR==2{print $3" used / "$2" ("$5"), "$4" free"}')"
  printf '%sUptime:%s %s\n' "$C_BOLD" "$C_RESET" "$(uptime -p 2>/dev/null)"
  if [ -r /sys/class/power_supply/BAT1/capacity ]; then
    printf '%sBattery:%s %s%% (%s)\n' "$C_BOLD" "$C_RESET" "$(cat /sys/class/power_supply/BAT1/capacity)" "$(cat /sys/class/power_supply/BAT1/status 2>/dev/null)"
  fi
}

cmd_network() {
  wise2_hr; printf '%sInterfaces:%s\n' "$C_BOLD" "$C_RESET"; ip -brief address
  printf '\n%sRoutes:%s\n' "$C_BOLD" "$C_RESET"; ip route
  printf '\n%sListening (tcp):%s\n' "$C_BOLD" "$C_RESET"; ss -tlnH 2>/dev/null | awk '{print "  "$4}' | sort -u
}

cmd_devices() {
  wise2_hr
  if wise2_have tailscale; then tailscale status 2>/dev/null || wise2_warn "tailscale status unavailable"; else wise2_fail "tailscale not installed"; fi
}

cmd_ssh() {
  wise2_hr; wise2_check_unit ssh "OpenSSH"
  wise2_info "Reach: ssh dwise@$(tailscale ip -4 2>/dev/null || echo '<tailscale-ip>')"
  wise2_info "Docs: $WISE2_ROOT/docs/REMOTE-ACCESS.md"
}

cmd_tailscale() {
  wise2_hr
  if wise2_have tailscale; then
    printf 'Tailscale IPv4: %s\n' "$(tailscale ip -4 2>/dev/null)"
    tailscale status 2>/dev/null | head -1 || true
    wise2_pass "tailscaled $(systemctl is-active tailscaled 2>/dev/null)"
  else wise2_fail "tailscale not installed"; fi
}

cmd_claude() {
  wise2_hr
  if wise2_have claude; then wise2_pass "Claude Code $(claude --version 2>/dev/null) @ $(command -v claude)"; else wise2_fail "claude not found"; fi
}

cmd_codex() {
  wise2_hr
  if wise2_have codex; then wise2_pass "Codex $(codex --version 2>/dev/null) @ $(command -v codex)";
  else wise2_warn "OpenAI Codex not installed (pending Phase 2). Shannon AI backend depends on it."; fi
}

cmd_hermes() {
  wise2_hr
  local client="$WISE2_ROOT/hermes/client/hermes-client.sh"
  if [ -x "$client" ]; then
    "$client" status
    wise2_info "Surface is a CLIENT of production Hermes. Pending: HERMES-PRODUCTION-CONNECTION-PENDING.md"
  else
    wise2_warn "Hermes client missing ($client)"
  fi
}

cmd_shannon() {
  wise2_hr
  if wise2_have wise2-shannon; then
    wise2_pass "Shannon launcher present: $(command -v wise2-shannon)"
    wise2_info "Version: $(wise2-shannon version 2>/dev/null | head -1 || echo 'run: wise2-shannon version')"
    wise2_info "Authorized engagements: wise2 pentest  (NO scan runs automatically)"
    local n; n=$(find "$WISE2_ROOT/security/engagements" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    wise2_info "Recorded engagements: $n"
  else wise2_fail "wise2-shannon not found"; fi
}

cmd_pentest() {
  wise2_hr
  if wise2_have wise2-pentest; then
    wise2_info "Launching guarded authorized-engagement wrapper (it will prompt for authorization)."
    exec wise2-pentest
  else wise2_fail "wise2-pentest not found"; fi
}

cmd_command() {
  wise2_hr
  if systemctl is-active --quiet wise2-command-center 2>/dev/null; then wise2_pass "Command Center service active";
  elif curl -fsS --max-time 2 http://127.0.0.1:3010/ >/dev/null 2>&1; then wise2_pass "Command Center responding on :3010";
  else wise2_warn "Command Center not running (scaffold — see $WISE2_ROOT/command-center/README.md)"; fi
}

cmd_projects() {
  wise2_hr; printf '%sProjects under %s/projects:%s\n' "$C_BOLD" "$WISE2_ROOT" "$C_RESET"
  local found=0
  for d in "$WISE2_ROOT"/projects/*/; do [ -d "$d" ] || continue; found=1; printf '  - %s\n' "$(basename "$d")"; done
  [ "$found" -eq 0 ] && wise2_info "No projects registered yet. See context/PROJECTS.md"
}

cmd_support() {
  wise2_hr
  wise2_info "Remote support is consent-based and OFF by default."
  wise2_info "See $WISE2_ROOT/support/README.md and docs/REMOTE-ACCESS.md"
}

cmd_backup() {
  local out stamp
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  out="$WISE2_ROOT/backups/wise2-config-$stamp.tar.gz"
  wise2_info "Backing up context + config + docs + scripts (no secrets/evidence)…"
  tar -czf "$out" \
    -C "$WISE2_ROOT" \
    --exclude='*.env' --exclude='*.key' --exclude='*.pem' --exclude='secrets' \
    context config docs scripts services CLAUDE.md .gitignore 2>/dev/null || true
  if [ -f "$out" ]; then wise2_pass "Backup: $out ($(du -h "$out" | cut -f1))"; else wise2_fail "Backup failed"; fi
}

cmd_update() {
  wise2_hr; wise2_info "Version check only — makes no changes."
  cmd_version
  wise2_info "System package updates require sudo and Daniel's approval (not run here)."
}

cmd_logs() {
  wise2_hr; printf '%sRecent WISE² logs (%s/logs):%s\n' "$C_BOLD" "$WISE2_ROOT" "$C_RESET"
  ls -1t "$WISE2_ROOT/logs" 2>/dev/null | head -10 | sed 's/^/  /' || wise2_info "none"
}

cmd_version() {
  wise2_hr
  printf '  wise2 CLI   %s\n' "$WISE2_CLI_VERSION"
  printf '  OS          %s\n' "$(. /etc/os-release; echo "$VERSION")"
  printf '  Kernel      %s\n' "$(uname -r)"
  printf '  Node        %s\n' "$(node --version 2>/dev/null || echo n/a)"
  printf '  Python      %s\n' "$(python3 --version 2>/dev/null || echo n/a)"
  printf '  Docker      %s\n' "$(docker --version 2>/dev/null | awk '{print $3}' | tr -d , || echo n/a)"
  printf '  Claude      %s\n' "$(claude --version 2>/dev/null || echo n/a)"
  printf '  Codex       %s\n' "$(codex --version 2>/dev/null || echo 'not installed')"
  printf '  Shannon     %s\n' "$(wise2-shannon version 2>/dev/null | head -1 || echo n/a)"
  printf '  Tailscale   %s\n' "$(tailscale version 2>/dev/null | head -1 || echo n/a)"
}

cmd_status() {
  banner; echo
  cmd_system; echo
  wise2_hr; printf '%sServices:%s\n' "$C_BOLD" "$C_RESET"
  wise2_check_unit ssh "OpenSSH"
  wise2_check_unit tailscaled "Tailscale"
  wise2_check_unit docker "Docker"
  wise2_check_unit bluetooth "Bluetooth"
  if systemctl is-active --quiet 'iptsd@dev-hidraw0' 2>/dev/null; then wise2_pass "Touch (iptsd)"; else wise2_warn "Touch (iptsd) not active"; fi
  echo
  wise2_hr; printf '%sAgents & modules:%s\n' "$C_BOLD" "$C_RESET"
  wise2_have claude && wise2_pass "Claude Code $(claude --version 2>/dev/null)" || wise2_fail "Claude Code missing"
  wise2_have codex  && wise2_pass "Codex present" || wise2_warn "Codex not installed (Phase 2)"
  wise2_have wise2-shannon && wise2_pass "Shannon launcher present" || wise2_fail "Shannon launcher missing"
}

cmd_doctor() {
  banner; echo; printf '%sWISE² doctor%s\n' "$C_BOLD" "$C_RESET"
  local pass=0 warn=0 fail=0
  chk() { # chk "label" test-cmd...
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then wise2_pass "$label"; pass=$((pass+1));
    else wise2_fail "$label"; fail=$((fail+1)); fi
  }
  chkw() { local label="$1"; shift; if "$@" >/dev/null 2>&1; then wise2_pass "$label"; pass=$((pass+1)); else wise2_warn "$label"; warn=$((warn+1)); fi; }

  wise2_hr; printf '%sCore:%s\n' "$C_BOLD" "$C_RESET"
  chk  "Surface kernel running"            bash -c '[ "$(uname -r)" = "6.19.8-surface-3" ]'
  chkw "Touch daemon (iptsd) active"       systemctl is-active --quiet 'iptsd@dev-hidraw0'
  chk  "OpenSSH active"                    systemctl is-active --quiet ssh
  chk  "Tailscale active"                  systemctl is-active --quiet tailscaled
  chk  "Docker active"                     systemctl is-active --quiet docker
  chk  "Docker usable by user"             docker info

  wise2_hr; printf '%sToolchain:%s\n' "$C_BOLD" "$C_RESET"
  chk  "node"      wise2_have node
  chk  "npm"       wise2_have npm
  chk  "python3"   wise2_have python3
  chk  "git"       wise2_have git
  chk  "docker"    wise2_have docker
  chk  "claude"    wise2_have claude
  chkw "gh (GitHub CLI)"  wise2_have gh
  chkw "codex"            wise2_have codex
  chkw "jq"               wise2_have jq
  chkw "rg (ripgrep)"     wise2_have rg
  chkw "tmux"             wise2_have tmux

  wise2_hr; printf '%sWISE² workspace:%s\n' "$C_BOLD" "$C_RESET"
  chk  "WISE² root present"        test -d "$WISE2_ROOT"
  chk  "context layer present"     test -f "$WISE2_ROOT/context/WISE2.md"
  chk  "CLAUDE.md present"         test -f "$WISE2_ROOT/CLAUDE.md"
  chk  "Shannon launcher"          wise2_have wise2-shannon
  chk  "Pentest gate launcher"     wise2_have wise2-pentest
  chkw "git identity configured"   git config --global user.email

  wise2_hr; printf '%sNetwork safety:%s\n' "$C_BOLD" "$C_RESET"
  chkw "No non-SSH public TCP (quick heuristic)" bash -c '! ss -tlnH | awk "{print \$4}" | grep -Eq "^(0\.0\.0\.0|\[::\]):(?!22)" '

  wise2_hr; printf '%sHermes (client; informational — not counted):%s\n' "$C_BOLD" "$C_RESET"
  if [ -x "$WISE2_ROOT/hermes/client/hermes-client.sh" ]; then
    "$WISE2_ROOT/hermes/client/hermes-client.sh" status 2>/dev/null | sed 's/^/  /'
  else
    wise2_warn "Hermes client missing"
  fi

  echo; wise2_hr
  printf '%sSummary:%s %s%d PASS%s  %s%d WARN%s  %s%d FAIL%s\n' \
    "$C_BOLD" "$C_RESET" "$C_GREEN" "$pass" "$C_RESET" "$C_YELLOW" "$warn" "$C_RESET" "$C_RED" "$fail" "$C_RESET"
  [ "$fail" -eq 0 ]
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status)    cmd_status "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    system)    cmd_system "$@" ;;
    network)   cmd_network "$@" ;;
    devices)   cmd_devices "$@" ;;
    ssh)       cmd_ssh "$@" ;;
    tailscale) cmd_tailscale "$@" ;;
    claude)    cmd_claude "$@" ;;
    codex)     cmd_codex "$@" ;;
    hermes)    cmd_hermes "$@" ;;
    shannon)   cmd_shannon "$@" ;;
    pentest)   cmd_pentest "$@" ;;
    command)   cmd_command "$@" ;;
    projects)  cmd_projects "$@" ;;
    support)   cmd_support "$@" ;;
    backup)    cmd_backup "$@" ;;
    update)    cmd_update "$@" ;;
    logs)      cmd_logs "$@" ;;
    version)   cmd_version "$@" ;;
    help|-h|--help) usage ;;
    *) printf '%sUnknown command:%s %s\n\n' "$C_RED" "$C_RESET" "$cmd"; usage; exit 2 ;;
  esac
}
main "$@"
