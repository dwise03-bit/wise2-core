#!/usr/bin/env bash
# =============================================================================
# wise2 — WISE² control CLI
# Safe, allowlisted subcommands. No eval. No browser-to-shell. Read-mostly.
# Install: symlink /usr/local/bin/wise2 -> /opt/wise2/scripts/wise2 (needs sudo)
# =============================================================================
set -euo pipefail

WISE2_ROOT="${WISE2_ROOT:-/opt/wise2}"
SCRIPTS="$WISE2_ROOT/scripts"
# shellcheck source=/opt/wise2/scripts/lib/common.sh
source "$SCRIPTS/lib/common.sh"

WISE2_CLI_VERSION="0.2.0"

banner() {
  printf '%s' "$C_GREEN"
  cat <<'EOF'
 __      __ _____  _____ ______ ²
 \ \    / /|_   _|/ ____|  ____|
  \ \  / /   | | | (___ | |__
   \ \/ /    | |  \___ \|  __|
    \  /    _| |_ ____) | |____
     \/    |_____|_____/|______|
EOF
  printf '%s  WISE² Linux control CLI  v%s%s\n' "$C_SILVER" "$WISE2_CLI_VERSION" "$C_RESET"
}

usage() {
  banner
  cat <<EOF

${C_BOLD}Usage:${C_RESET} wise2 <command>

  ${C_CYAN}status${C_RESET}     Observed WISE² overview
  ${C_CYAN}services${C_RESET}   Observed system and WISE² service state
  ${C_CYAN}node${C_RESET}       Local registered node observations
  ${C_CYAN}command-center${C_RESET} status | restart | logs
  ${C_CYAN}doctor${C_RESET}     PASS/WARN/FAIL diagnostic
  ${C_CYAN}system${C_RESET}     Host / CPU / RAM / disk / kernel
  ${C_CYAN}network${C_RESET}    Interfaces, routes, listening ports
  ${C_CYAN}devices${C_RESET}    Local registry + observed peer presence
  ${C_CYAN}ssh${C_RESET}        SSH service + remote-access info
  ${C_CYAN}tailscale${C_RESET}  Tailscale mesh status
  ${C_CYAN}claude${C_RESET}     Claude Code agent status
  ${C_CYAN}codex${C_RESET}      OpenAI Codex agent status
  ${C_CYAN}hermes${C_RESET}     Hermes second-brain status
  ${C_CYAN}shannon${C_RESET}    Shannon security engine status (no scan)
  ${C_CYAN}pentest${C_RESET}    Launch guarded authorized engagement (prompts)
  ${C_CYAN}command${C_RESET}    Command Center status (alias)
  ${C_CYAN}projects${C_RESET}   List WISE² projects
  ${C_CYAN}support${C_RESET}    Remote-support status
  ${C_CYAN}backup${C_RESET}     create | list | verify [archive-name]
  ${C_CYAN}update${C_RESET}     Check component versions (no changes)
  ${C_CYAN}logs${C_RESET}       Show recent WISE² logs
  ${C_CYAN}version${C_RESET}    Versions of WISE² components
  ${C_CYAN}help${C_RESET}       This help
EOF
}

cmd_system() {
  wise2_hr
  printf '%sHost:%s   %s\n' "$C_BOLD" "$C_RESET" "$(hostnamectl --static 2>/dev/null)"
  printf '%sOS:%s     %s\n' "$C_BOLD" "$C_RESET" "$(. /etc/os-release; echo "$PRETTY_NAME")"
  printf '%sKernel:%s %s\n' "$C_BOLD" "$C_RESET" "$(uname -r)"
  printf '%sCPU:%s    %s\n' "$C_BOLD" "$C_RESET" "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
  printf '%sRAM:%s    %s\n' "$C_BOLD" "$C_RESET" "$(free -h | awk '/^Mem:/{print $3" used / "$2" total ("$7" avail)"}')"
  printf '%sDisk:%s   %s\n' "$C_BOLD" "$C_RESET" "$(df -h / | awk 'NR==2{print $3" used / "$2" ("$5"), "$4" free"}')"
  printf '%sUptime:%s %s\n' "$C_BOLD" "$C_RESET" "$(uptime -p 2>/dev/null)"
  if [ -r /sys/class/power_supply/BAT1/capacity ]; then
    printf '%sBattery:%s %s%% (%s)\n' "$C_BOLD" "$C_RESET" "$(cat /sys/class/power_supply/BAT1/capacity)" "$(cat /sys/class/power_supply/BAT1/status 2>/dev/null)"
  fi
}

cmd_network() {
  wise2_hr; printf '%sInterfaces:%s\n' "$C_BOLD" "$C_RESET"; ip -brief address
  printf '\n%sRoutes:%s\n' "$C_BOLD" "$C_RESET"; ip route
  printf '\n%sListening (tcp):%s\n' "$C_BOLD" "$C_RESET"; ss -tlnH 2>/dev/null | awk '{print "  "$4}' | sort -u
}


cmd_ssh() {
  wise2_hr; wise2_check_unit ssh "OpenSSH"
  wise2_info "Reach: ssh dwise@$(tailscale ip -4 2>/dev/null || echo '<tailscale-ip>')"
  wise2_info "Docs: $WISE2_ROOT/docs/REMOTE-ACCESS.md"
}






cmd_pentest() {
  wise2_hr
  if wise2_have wise2-pentest; then
    wise2_info "Launching guarded authorized-engagement wrapper (it will prompt for authorization)."
    if [ "$#" -ne 0 ]; then wise2_fail "pentest takes no arguments; the preserved gate prompts for scope and authorization"; return 2; fi
    exec wise2-pentest
  else wise2_fail "wise2-pentest not found"; fi
}



cmd_support() {
  wise2_hr
  wise2_info "Remote support is consent-based and OFF by default."
  wise2_info "See $WISE2_ROOT/support/README.md and docs/REMOTE-ACCESS.md"
}







main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status|doctor|services|logs|devices|node|hermes|shannon|projects|backup|update|version|command|command-center|tailscale|claude|codex)
      exec python3 "$WISE2_ROOT/core/cli.py" "$cmd" "$@" ;;
  esac
  case "$cmd" in
    system)    cmd_system "$@" ;;
    network)   cmd_network "$@" ;;
    ssh)       cmd_ssh "$@" ;;
    pentest)   cmd_pentest "$@" ;;
    support)   cmd_support "$@" ;;
    help|-h|--help) usage ;;
    *) printf '%sUnknown command:%s %s\n\n' "$C_RED" "$C_RESET" "$cmd"; usage; exit 2 ;;
  esac
}
main "$@"
