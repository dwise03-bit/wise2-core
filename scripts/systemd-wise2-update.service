[Unit]
Description=WISE² Pi Automated Update Service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
Documentation=file:///opt/wise2-edge/scripts/UPDATE_PI_GUIDE.md

[Service]
Type=oneshot
User=pi
WorkingDirectory=/opt/wise2-edge

# Main update command
ExecStart=/opt/wise2-edge-scripts/update-pi.sh pi.local full-stack

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wise2-update

# Resource limits (prevent resource exhaustion)
CPUQuota=80%
MemoryLimit=512M
TimeoutStartSec=1800

# Restart policy (don't auto-restart, it's a oneshot)
Restart=no

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/wise2-edge /opt/wise2-edge-backups /var/log/wise2-edge-appliance

# Environment (can be overridden by systemd-override)
Environment="SSH_USER=pi"
Environment="ADMIN_EMAIL=dwise03@gmail.com"
Environment="NOTIFY_EMAIL=true"

[Install]
WantedBy=multi-user.target
