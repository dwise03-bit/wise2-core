{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wise2-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--parallel"
      ],
      "port": 3001,
      "autoPort": true,
      "description": "WISE\u00b2 Development Environment - All Services",
      "details": "Starts all apps in parallel:\n- Website: localhost:3001\n- Dashboard: localhost:3002\n- Admin: localhost:3003\n- Studio: localhost:3005\n- API: localhost:3010"
    },
    {
      "name": "getdown-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wise2/getdown-demo",
        "dev"
      ],
      "port": 3020,
      "description": "Get Down Pressure Washing — Owner Demo Command Center"
    },
    {
      "name": "command-center",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=apps/command-center"
      ],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=apps/website"
      ],
      "port": 3001,
      "autoPort": true
    }
  ]
}