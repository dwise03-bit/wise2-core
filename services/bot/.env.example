# Discord Bot Configuration - Phase A

# Bot Authentication
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Server/Guild Configuration
DISCORD_GUILD_ID=your_guild_id_here

# Webhooks for Channel Integration
# Get these by creating webhooks in each channel (Settings > Webhooks > New Webhook)
DISCORD_WEBHOOK_DEPLOYMENTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_BUILDS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_DECISIONS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_DAILY_SYNC=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_STATUS=https://discord.com/api/webhooks/...

# Data Directory (for reading logs and decisions)
DATA_DIR=../../data

# WISE² ad creatives directory for /run-ads
# Defaults to your local Downloads folder if omitted.
WISE2_ADS_DIR=/Users/danielwise/Downloads/WISE2_Revenue_Blitz_Ads

# Second Brain API bridge for /brain-status, /brain-search, /brain-save
# Point this at the second-brain API root; the bot will append /api automatically if needed.
SECOND_BRAIN_API_URL=http://127.0.0.1:3012
SECOND_BRAIN_JWT_SECRET=your_shared_brain_secret
SECOND_BRAIN_SERVICE_SUB=discord-bot
SECOND_BRAIN_BUSINESS=wise2

# Deployment Info (used by /deploy command)
DEPLOY_SERVER=173.208.147.165 (gpu-nmls)
NODE_ENV=production
