[Unit]
Description=WISE² cross-device git sync (safe, non-destructive)
Documentation=file:///opt/wise2/docs/CROSS-DEVICE-SYNC.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Prefer the staging script until main includes it; after the merge lands,
# switch to /opt/wise2/scripts/wise2-sync. Pass each repo as an argument so
# both the production tree (/opt/wise2) and the staging tree stay in sync.
ExecStart=%h/wise2-level-up/scripts/wise2-sync /opt/wise2 %h/wise2-level-up
# Hard safety: never run with elevated privileges.
NoNewPrivileges=true
# Prevent accidental writes outside the dirs listed below.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/wise2 %h/wise2-level-up %h/.local/share/wise2
PrivateTmp=true
