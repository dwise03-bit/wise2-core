{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/ops-protocol/src/*.ts"
  ],
  "exclude": [
    "src/__tests__/**",
    "src/lib/dispatch.ts",
    "src/lib/tasks.ts"
  ]
}
