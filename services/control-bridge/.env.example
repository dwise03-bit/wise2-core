WISE2_CONTROL_TOKEN=
WISE2_CONTROL_HOST=127.0.0.1
WISE2_CONTROL_PORT=3099
WISE2_REPO_DIR=/workspace
WISE2_COMPOSE_FILE=/workspace/docker-compose.production.yml
WISE2_COMPOSE_PROJECT_NAME=wise2-core
WISE2_AUDIT_FILE=/data/control-bridge/audit.jsonl
WISE2_DEPLOYMENT_FILE=/data/control-bridge/deployments.jsonl
WISE2_ALLOWED_SERVICES=postgres,redis,mongodb,api,ollama,open-webui,website,dashboard,admin,studio,command-center,worker,prometheus,grafana
WISE2_ALLOWED_APPS=website,dashboard,admin,studio,command-center,api,worker
WISE2_OLLAMA_URL=http://127.0.0.1:11434/api/tags
WISE2_HERMES_URL=http://127.0.0.1:3012/api/health
WISE2_HERMES_IMAGE_URL=http://127.0.0.1:3010/v1/hermes/image
# Dedicated JWT/service bearer accepted by the WISE2 API for /v1/hermes/image.
# Never reuse WISE2_CONTROL_TOKEN here.
WISE2_HERMES_BEARER_TOKEN=
WISE2_PUBLIC_URL=https://wise2.net
WISE2_API_HEALTH_URL=http://127.0.0.1:3010/api/health
