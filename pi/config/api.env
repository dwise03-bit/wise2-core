# WISE² API environment for Raspberry Pi builds
# This file is copied into the API image as .env.production during build.
#
# Secrets are generated by pi/scripts/install.sh into pi/.env for runtime use.

NODE_ENV=production
ENVIRONMENT=pi
APP_NAME="WISE² Enterprise"
APP_VERSION="1.0.0-pi"
LOG_LEVEL=info

DATABASE_URL="file:/data/wise2.db"
DB_TYPE="sqlite"

REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

PORT=3000
HOST="0.0.0.0"

OLLAMA_ENABLED=false
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

HOSTNAME=wise
MDNS_ENABLED=true

BACKUP_DIR=/backups
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION=7

LOAD_DEMO_DATA=true
DEMO_BUSINESSES="coffee-shop,hvac-company,tattoo-studio,church,restaurant,auto-repair,gym"

PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

DEBUG=false
VERBOSE_LOGGING=false
